<!DOCTYPE html>
<html lang="en">
<head>
<% locals.canonicalPath = '/services'; %>
<% locals.breadcrumbs = [{ name:'Home', path:'/' }, { name:'Services', path:'/services' }]; %>
<%- include('partials/page-head') %>
</head>
<body class="lp-wrap">
<%- include('partials/navbar') %>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section class="page-hero">
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="lp-c page-hero-inner">
    <%- include('partials/breadcrumb') %>
    <div class="lp-pill" aria-hidden="true">Engineering & Digital Solutions</div>
    <h1>Digital Experiences Built to Grow Your Business</h1>
    <p class="lead">From high-conversion websites and powerful e-commerce stores to custom software, mobile apps, and automated workflows — StackifyX builds modern, scalable digital solutions for businesses across India.</p>
    <div class="hero-btns">
      <a href="/contact" class="btn btn-primary btn-lg">Get a Free Consultation →</a>
      <a href="/work" class="btn btn-secondary btn-lg">Explore Our Work</a>
    </div>
  </div>
</section>

<!-- ═══════════════════ SERVICE CARDS ═══════════════════ -->
<section class="lp-section lp-section-alt">
  <div class="lp-c">
    <div class="svc-grid">
      <%
      const serviceList = [
        {
          icon:'<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
          title:'Website Development',
          slug:'website-development',
          desc:'Fast, responsive, and SEO-engineered corporate websites, business landing pages, and interactive marketing platforms.',
          features:['Business & corporate websites', 'High-converting landing pages', 'SEO-friendly semantic HTML5', 'Speed & Core Web Vitals optimization', 'Lead capture & WhatsApp integration']
        },
        {
          icon:'<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>',
          title:'E-Commerce Development',
          slug:'ecommerce-development',
          desc:'Custom online stores engineered to convert — intuitive product catalogs, Razorpay UPI checkout, and automated inventory sync.',
          features:['Product catalog & categories', 'Friction-free mobile checkout', 'Razorpay & UPI integration', 'Order & stock management', 'Customer accounts & history']
        },
        {
          icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
          title:'Custom Software Development',
          slug:'custom-software-development',
          desc:'Tailored software designed around your specific business workflows instead of forcing your team into generic templates.',
          features:['Business Management Systems (BMS)', 'Custom CRM & ERP platforms', 'Healthcare & clinical software', 'Role-based access control', 'Real-time dashboards']
        },
        {
          icon:'<rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
          title:'Mobile App Development',
          slug:'mobile-app-development',
          desc:'High-performance cross-platform mobile apps for Android and iOS sharing unified data with your web backend.',
          features:['Android & iOS apps (single codebase)', 'Secure authentication & OTP', 'Push notification marketing', 'Offline sync capabilities', 'App store release support']
        },
        {
          icon:'<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
          title:'Web Application Development',
          slug:'web-application-development',
          desc:'Full-stack web applications, SaaS platforms, and client portals built with Node.js, Express, MongoDB, and modern real-time capabilities.',
          features:['SaaS platforms & cloud MVPs', 'Custom client portals', 'Role-based access & auth', 'Interactive dashboards & charts', 'Real-time Socket.IO sync']
        },
        {
          icon:'<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>',
          title:'SEO Services',
          slug:'seo-services',
          desc:'Technical SEO, on-page optimization, Schema markup, and speed audits designed to rank Indian businesses on Google search.',
          features:['Technical SEO audits', 'Schema.org JSON-LD markup', 'Core Web Vitals acceleration', 'Local SEO & Google Business optimization', 'Keyword strategy & tracking']
        },
        {
          icon:'<path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>',
          title:'Website Redesign',
          slug:'website-redesign',
          desc:'Modernize outdated websites with premium dark/light UI, blazing-fast load speeds, mobile responsiveness, and higher conversion rates.',
          features:['Legacy code modernization', 'Conversion rate optimization (CRO)', 'Mobile UI/UX overhaul', 'Zero search ranking loss migration', 'High-trust branding']
        },
        {
          icon:'<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>',
          title:'AI & Business Automation',
          slug:'ai-business-automation',
          desc:'Automate repetitive tasks, lead intake, follow-ups, and document processing to save hours of manual busywork each week.',
          features:['Automated WhatsApp & email triage', 'Smart document data extraction', 'Workflow & CRM synchronization', 'OpenAI & Gemini API integrations', 'Zero expensive internal AI infra']
        },
        {
          icon:'<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>',
          title:'API Development & Integration',
          slug:'api-development',
          desc:'Robust, secure REST APIs connecting your website, mobile applications, payment systems, and third-party enterprise tools.',
          features:['Custom REST API architecture', 'Payment gateway webhooks', 'WhatsApp Business API setup', 'CRM & ERP data connectors', 'Complete Swagger/Postman docs']
        },
        {
          icon:'<path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>',
          title:'SaaS Platform Development',
          slug:'saas-development',
          desc:'Multi-user subscription platforms with admin panels and API-based architecture built to scale with your user base.',
          features:['Multi-tenant cloud architecture', 'Subscription billing & tiers', 'Role-based permissions', 'Admin analytics panels', 'OAuth & Google sign-in']
        },
        {
          icon:'<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>',
          title:'UI/UX Design',
          slug:'ui-ux-design',
          desc:'Clean, usable interface and user-experience design for websites, applications and dashboards before writing code.',
          features:['Modern design systems', 'Mobile-first UX prototypes', 'Accessible color contrast', 'Dashboard & portal UI', 'User flow wireframes']
        },
        {
          icon:'<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
          title:'Website Maintenance & Support',
          slug:'website-maintenance',
          desc:'Continuous care after launch — bug fixes, performance tuning, security patches, and ongoing feature enhancements.',
          features:['Routine security audits', 'Core Web Vitals tuning', 'Scheduled backups', 'Priority bug resolution', 'Client dashboard support']
        }
      ];
      %>
      <% serviceList.forEach(s => { %>
        <div class="svc-card">
          <div class="svc-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- s.icon %></svg>
          </div>
          <h2 class="svc-title"><%= s.title %></h2>
          <p class="svc-desc"><%= s.desc %></p>
          <ul style="list-style:none; padding:0; margin:0 0 24px; font-size:0.84rem; color:var(--text-muted); line-height:1.7;">
            <% s.features.forEach(f => { %>
              <li style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                <span style="color:var(--accent-blue); font-weight:800;">✓</span> <%= f %>
              </li>
            <% }) %>
          </ul>
          <a href="/services/<%= s.slug %>" class="svc-link" style="margin-top:auto;" aria-label="Learn more about <%= s.title %>">
            Explore <%= s.title %>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════════ CTA ═══════════════════ -->
<section class="lp-section">
  <div class="lp-c" style="max-width:900px;">
    <div class="cta-box">
      <div class="cta-glow-1" aria-hidden="true"></div>
      <div class="cta-glow-2" aria-hidden="true"></div>
      <div class="lp-pill" style="background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.25);color:#fff;" aria-hidden="true">Get Started</div>
      <h2 class="cta-title">Not Sure Which Service Fits Your Need?</h2>
      <p class="cta-desc">Tell us what you are trying to achieve and our senior developers will guide you to the right architecture and roadmap.</p>
      <div class="cta-btns">
        <a href="/contact" class="cta-btn-p">Get a Free Consultation</a>
        <a href="https://wa.me/918600214628" target="_blank" rel="noopener noreferrer" class="cta-btn-s">Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/site-footer') %>
</body>
</html>
