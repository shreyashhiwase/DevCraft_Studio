<!DOCTYPE html>
<html lang="en">
<head>
<% locals.canonicalPath = '/services'; %>
<% locals.breadcrumbs = [{ name:'Home', path:'/' }, { name:'Services', path:'/services' }]; %>
<%- include('partials/page-head') %>
</head>
<body class="lp-wrap">
<%- include('partials/navbar') %>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section class="page-hero">
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="lp-c page-hero-inner">
    <%- include('partials/breadcrumb') %>
    <div class="lp-pill" aria-hidden="true">What We Build</div>
    <h1>Digital Solutions Built Around Your Business</h1>
    <p class="lead">From websites and mobile apps to custom software and automation, StackifyX helps businesses turn ideas into reliable digital products.</p>
    <div class="hero-btns">
      <a href="/auth/register" class="btn btn-primary btn-lg">Start Your Project →</a>
      <a href="/contact" class="btn btn-secondary btn-lg">Talk to Us</a>
    </div>
  </div>
</section>

<!-- ═══════════════════ SERVICE CARDS ═══════════════════ -->
<section class="lp-section lp-section-alt">
  <div class="lp-c">
    <div class="svc-grid" style="grid-template-columns:repeat(2,1fr);">
      <%
      const services = [
        {
          icon:'<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
          title:'Web Development',
          desc:'Professional websites and powerful web applications designed for businesses, startups and organizations.',
          features:['Business & corporate websites','SaaS applications & web portals','Admin dashboards','Custom web applications','Responsive design','API integration'],
        },
        {
          icon:'<rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
          title:'Mobile App Development',
          desc:'Cross-platform and native mobile applications built for real business and customer use cases.',
          features:['Android applications','iOS applications','Cross-platform applications','Business & customer-facing apps','Authentication','Push notifications'],
        },
        {
          icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
          title:'Custom Software Development',
          desc:'Tailored software designed around your specific business workflows instead of generic templates.',
          features:['Business management software','CRM & ERP systems','Healthcare & pharmacy software','Inventory systems','Booking & management platforms','Custom workflows'],
        },
        {
          icon:'<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>',
          title:'E-Commerce Development',
          desc:'Online stores built to convert — from product catalog to checkout and order management.',
          features:['Product management','Shopping cart & checkout','Payment integration','Order management & inventory','Customer accounts','Admin dashboard'],
        },
        {
          icon:'<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>',
          title:'AI & Automation',
          desc:'AI-powered tools and workflow automation to save time and reduce manual, repetitive work.',
          features:['Business process automation','AI-powered tools','Document processing','Workflow automation','Intelligent assistants','API-based AI integration'],
        },
        {
          icon:'<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>',
          title:'API Development & Integration',
          desc:'Robust, secure APIs and third-party integrations that connect your business systems.',
          features:['REST API development','Third-party API integration','Payment API integration','Authentication APIs','Database integration','External service integration'],
        },
        {
          icon:'<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
          title:'Database Design',
          desc:'Well-structured, secure data architecture that stays reliable as your product grows.',
          features:['MongoDB database architecture','Data modeling','Query optimization','Secure data management'],
        },
        {
          icon:'<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
          title:'Cloud & Deployment',
          desc:'Production deployment on infrastructure StackifyX already builds and runs on.',
          features:['Render cloud deployment','Environment configuration','Production deployment','Domain & SSL/HTTPS configuration'],
        },
      ];
      %>
      <% services.forEach((s) => { %>
        <div class="svc-card">
          <div class="svc-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- s.icon %></svg>
          </div>
          <h2 class="svc-title" style="font-size:1.1rem;"><%= s.title %></h2>
          <p class="svc-desc"><%= s.desc %></p>
          <div class="about-checklist" style="margin-top:0;margin-bottom:18px;">
            <% s.features.forEach(f => { %>
              <div class="about-check" style="font-size:0.82rem;">
                <div class="about-check-icon" style="width:18px;height:18px;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <%= f %>
              </div>
            <% }) %>
          </div>
          <a href="/contact" class="svc-link" aria-label="Discuss a <%= s.title %> project">
            Discuss This Project
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════════ CTA ═══════════════════ -->
<section class="lp-section">
  <div class="lp-c" style="max-width:900px;">
    <div class="cta-box">
      <div class="cta-glow-1" aria-hidden="true"></div>
      <div class="cta-glow-2" aria-hidden="true"></div>
      <div class="lp-pill" style="background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.25);color:#fff;" aria-hidden="true">Ready to Build?</div>
      <h2 class="cta-title">Not Sure Which Service<br>Fits Your Project?</h2>
      <p class="cta-desc">Tell us about your idea and we'll help you figure out the right approach — no obligation.</p>
      <div class="cta-btns">
        <a href="/contact" class="cta-btn-p">Talk to Us</a>
        <a href="/work" class="cta-btn-s">See Our Work</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/site-footer') %>
</body>
</html>
