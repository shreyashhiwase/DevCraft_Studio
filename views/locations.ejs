<!DOCTYPE html>
<html lang="en">
<head>
<% locals.canonicalPath = '/locations'; %>
<% locals.breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Locations', path: '/locations' }]; %>
<%- include('partials/page-head') %>
</head>
<body class="lp-wrap">
<%- include('partials/navbar') %>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section class="page-hero">
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="lp-c page-hero-inner">
    <%- include('partials/breadcrumb') %>
    <div class="lp-pill" aria-hidden="true">Pan-India Reach</div>
    <h1>Serving Businesses Across India</h1>
    <p class="lead">StackifyX provides professional website development, e-commerce stores, and custom software to clients throughout India. We partner remotely with founders, clinics, institutions, and growing enterprises via transparent, milestone-driven digital collaboration.</p>
    <div class="hero-btns">
      <a href="/contact" class="btn btn-primary btn-lg">Get a Free Consultation →</a>
      <a href="https://wa.me/918600214628" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg" style="display:inline-flex;align-items:center;gap:8px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2.001c-5.523 0-10 4.477-10 10 0 1.77.464 3.489 1.343 5.003L2 22l5.13-1.326a9.96 9.96 0 004.871 1.24h.004c5.522 0 9.999-4.478 9.999-10 0-2.652-1.03-5.14-2.929-7.014A9.926 9.926 0 0012.001 2zm5.94 15.94a8.264 8.264 0 01-5.936 2.463h-.003a8.283 8.283 0 01-4.223-1.156l-.303-.18-3.043.787.813-2.965-.198-.304a8.256 8.256 0 01-1.265-4.394c0-4.57 3.72-8.29 8.294-8.29 2.216 0 4.298.863 5.865 2.431a8.235 8.235 0 012.427 5.866c0 4.57-3.72 8.29-8.29 8.29z"/></svg>
        WhatsApp Consultation
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════ REMOTE COLLABORATION MODEL ═══════════════════ -->
<section class="lp-section lp-section-alt" style="padding: 56px 0;">
  <div class="lp-c">
    <div style="max-width: 860px; margin: 0 auto; text-align: center;">
      <h2 style="font-size: 1.6rem; font-weight: 800; color: var(--text-primary); margin-bottom: 14px;">How We Partner With Clients Across India</h2>
      <p style="font-size: 0.95rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 32px;">
        Physical distance is no barrier to high-velocity software delivery. We work with clients across Mumbai, Pune, Bengaluru, Delhi, Hyderabad, and regional commercial centers using clear milestone demos, staging links, real-time WhatsApp updates, and our dedicated client portal.
      </p>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; text-align: left;">
        <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 22px;">
          <div style="font-size: 1.1rem; font-weight: 800; color: var(--accent-blue); margin-bottom: 6px;">01. Video Discovery</div>
          <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; margin: 0;">In-depth requirement scoping and feature planning over Google Meet or Zoom.</p>
        </div>
        <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 22px;">
          <div style="font-size: 1.1rem; font-weight: 800; color: var(--accent-purple); margin-bottom: 6px;">02. Staging Links</div>
          <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; margin: 0;">Review actual live previews on mobile and desktop as each sprint milestone is completed.</p>
        </div>
        <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 22px;">
          <div style="font-size: 1.1rem; font-weight: 800; color: var(--accent-green); margin-bottom: 6px;">03. Client Portal</div>
          <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; margin: 0;">Track invoices, request updates, view project milestones, and chat in real time.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════ CITIES BY REGION ═══════════════════ -->
<section class="lp-section">
  <div class="lp-c">
    <div class="lp-heading center" style="margin-bottom: 56px;">
      <div class="lp-pill" aria-hidden="true">City Directory</div>
      <h2>Select Your City</h2>
      <p>Discover localized insights, industry-specific web solutions, and remote collaboration details for your market.</p>
    </div>

    <% Object.entries(stateGroups).forEach(([groupName, groupCities]) => { %>
      <div class="loc-state-group">
        <h3 class="loc-state-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--accent-blue);"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <%= groupName %>
        </h3>
        <div class="loc-grid">
          <% groupCities.forEach(city => { %>
            <a href="/locations/<%= city.slug %>" class="loc-card">
              <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
                <h4 style="font-size:1.1rem; font-weight:800; color:var(--text-primary); margin:0;"><%= city.cityName %></h4>
                <span style="font-size:0.7rem; font-weight:700; color:var(--accent-blue); background:rgba(37,99,235,0.1); padding:3px 8px; border-radius:100px;">Explore →</span>
              </div>
              <p style="font-size:0.84rem; color:var(--text-muted); line-height:1.6; margin:0 0 12px;"><%= city.heroTag %></p>
              <div style="font-size:0.76rem; color:var(--accent-green); font-weight:600;">
                ✓ Remote Collaboration Available
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- ═══════════════════ CTA ═══════════════════ -->
<section class="lp-section lp-section-alt">
  <div class="lp-c" style="max-width:900px;">
    <div class="cta-box">
      <div class="cta-glow-1" aria-hidden="true"></div>
      <div class="cta-glow-2" aria-hidden="true"></div>
      <div class="lp-pill" style="background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.25);color:#fff;" aria-hidden="true">Pan-India Support</div>
      <h2 class="cta-title">Don't See Your City Listed?</h2>
      <p class="cta-desc">We collaborate remotely with clients in every state and union territory in India. Reach out today for a free discovery call.</p>
      <div class="cta-btns">
        <a href="/contact" class="cta-btn-p">Get a Free Consultation</a>
        <a href="https://wa.me/918600214628" target="_blank" rel="noopener noreferrer" class="cta-btn-s">Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/site-footer') %>
</body>
</html>
