<!DOCTYPE html>
<html lang="en">
<head>
<% locals.canonicalPath = '/why-us'; %>
<% locals.breadcrumbs = [{ name:'Home', path:'/' }, { name:'Why Choose Us', path:'/why-us' }]; %>
<%- include('partials/page-head') %>
</head>
<body class="lp-wrap">
<%- include('partials/navbar') %>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section class="page-hero">
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="lp-c page-hero-inner">
    <%- include('partials/breadcrumb') %>
    <div class="lp-pill" aria-hidden="true">Why StackifyX</div>
    <h1>Why Businesses Choose StackifyX</h1>
    <p class="lead">We don't make generic promises. Here's specifically what sets us apart as a digital product development partner.</p>
  </div>
</section>

<!-- ═══════════════════ REASONS ═══════════════════ -->
<section class="lp-section lp-section-alt">
  <div class="lp-c">
    <div class="why-grid" style="grid-template-columns:repeat(2,1fr);">
      <%
      const whys = [
        { icon:'<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>', title:'Custom-Built Solutions', desc:'We build around your business requirements instead of forcing you into generic templates — your workflows, your users, your goals.' },
        { icon:'<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>', title:'Transparent Development', desc:'Clients can understand project progress, milestones and development stages through the client dashboard — no wondering what\'s happening.' },
        { icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>', title:'Modern Technology', desc:'We use modern, maintainable technologies appropriate to the project — chosen for reliability, not novelty for its own sake.' },
        { icon:'<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>', title:'Scalable Architecture', desc:'We build solutions that can evolve as the business grows, so your product doesn\'t need a full rewrite the moment you scale.' },
        { icon:'<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>', title:'Security & Reliability', desc:'We follow appropriate security and development best practices throughout the build, not bolted on at the end.' },
        { icon:'<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>', title:'Direct Communication', desc:'Clear communication throughout the development process — real-time chat with the team, not a chain of account managers.' },
        { icon:'<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>', title:'Business-Focused Development', desc:'We focus on solving business problems rather than simply writing code — every feature should earn its place.' },
        { icon:'<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>', title:'Post-Launch Support', desc:'We support clients after deployment where applicable — questions, bug fixes and improvements don\'t stop at handover.' },
      ];
      %>
      <% whys.forEach((w) => { %>
        <div class="why-card">
          <div class="why-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- w.icon %></svg>
          </div>
          <h2 class="why-title" style="font-size:1.02rem;"><%= w.title %></h2>
          <p class="why-desc"><%= w.desc %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════════ MORE THAN JUST DEVELOPMENT ═══════════════════ -->
<section class="lp-section" aria-labelledby="mtd-heading">
  <div class="lp-c">
    <div class="lp-heading center" style="margin-bottom:48px;">
      <div class="lp-pill" aria-hidden="true">Our Philosophy</div>
      <h2 id="mtd-heading">More Than Just Development</h2>
      <p>StackifyX follows a structured path from idea to a supported, live product — not just "write the code and hand it over."</p>
    </div>
    <div class="proc-grid" role="list" style="grid-template-columns:repeat(7,1fr);">
      <%
      const timeline = [
        { n:'01', title:'Idea',        icon:'<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>' },
        { n:'02', title:'Planning',    icon:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>' },
        { n:'03', title:'Design',      icon:'<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.5-.7 1.5-1.5 0-.4-.1-.7-.4-1-.2-.3-.4-.6-.4-1 0-.8.7-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-4.4-4.5-8-10-8z"/>' },
        { n:'04', title:'Development', icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>' },
        { n:'05', title:'Testing',     icon:'<path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/>' },
        { n:'06', title:'Deployment',  icon:'<path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/>' },
        { n:'07', title:'Support',     icon:'<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>' },
      ];
      %>
      <% timeline.forEach((s, i) => { %>
        <div class="proc-step" role="listitem" style="padding:24px 12px;">
          <div class="proc-icon" aria-hidden="true" style="width:42px;height:42px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- s.icon %></svg>
          </div>
          <div class="proc-num"><%= s.n %></div>
          <h3 class="proc-title" style="font-size:0.85rem;"><%= s.title %></h3>
          <% if (i < timeline.length - 1) { %>
            <div class="proc-arr" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════════ CTA ═══════════════════ -->
<section class="lp-section lp-section-alt">
  <div class="lp-c" style="max-width:900px;">
    <div class="cta-box">
      <div class="cta-glow-1" aria-hidden="true"></div>
      <div class="cta-glow-2" aria-hidden="true"></div>
      <div class="lp-pill" style="background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.25);color:#fff;" aria-hidden="true">Ready to Build?</div>
      <h2 class="cta-title">Let's See If We're<br>The Right Fit</h2>
      <p class="cta-desc">Tell us about your project — we'll be upfront about whether and how we can help.</p>
      <div class="cta-btns">
        <a href="/contact" class="cta-btn-p">Start a Conversation</a>
        <a href="/about" class="cta-btn-s">Learn More About Us</a>
      </div>
    </div>
  </div>
</section>

<style>
@media(max-width:1100px){ .proc-grid[style*="repeat(7"]{ grid-template-columns:repeat(4,1fr)!important; } }
@media(max-width:640px){ .proc-grid[style*="repeat(7"]{ grid-template-columns:repeat(2,1fr)!important; } }
</style>

<%- include('partials/site-footer') %>
</body>
</html>
