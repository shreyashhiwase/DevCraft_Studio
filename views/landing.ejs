<!-- Intersection Observer: fade-up animations -->
<script>
var testiCurrent=0;
var testiSlides=2;
function testiGo(idx){
  testiCurrent=idx;
  document.getElementById('testiTrack').style.transform='translateX(-'+(idx*100)+'%)';
  document.querySelectorAll('.testi-dot').forEach(function(d,i){
    d.style.background=i===idx?'var(--accent-blue)':'var(--border)';
    d.setAttribute('aria-selected',i===idx?'true':'false');
  });
}
function testiNext(){ testiGo((testiCurrent+1)%testiSlides); }
function testiPrev(){ testiGo((testiCurrent-1+testiSlides)%testiSlides); }
var testiTimer=setInterval(testiNext,6000);
document.getElementById('testiWrap')&&document.getElementById('testiWrap').addEventListener('mouseenter',function(){clearInterval(testiTimer);});
document.getElementById('testiWrap')&&document.getElementById('testiWrap').addEventListener('mouseleave',function(){testiTimer=setInterval(testiNext,6000);});

(function(){
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  },{ threshold:0.12 });
  document.querySelectorAll('.fade-up').forEach(function(el){ obs.observe(el); });

  // Anchor smooth scroll (navbar already handles, this covers footer links)
  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click',function(e){
      var href=a.getAttribute('href');
      if(href==='#')return;
      var t=document.querySelector(href);
      if(t){
        e.preventDefault();
        var navH=document.getElementById('mainNavbar').offsetHeight;
        window.scrollTo({top:t.getBoundingClientRect().top+window.scrollY-navH-8,behavior:'smooth'});
      }
    });
  });
})();
</script>
</body>
