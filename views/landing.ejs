        Our Capabilities
      </div>
      <h2 id="svc-heading">Software Solutions Engineered for Growth</h2>
      <p>From idea to production deployment, we provide the full engineering stack your business needs to succeed.</p>
    </div>
    <div class="svc-grid">
      <%
      const flagshipServices = [
        { icon:'<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>', title:'Website Development', slug:'website-development', desc:'Fast, mobile-responsive business websites and web applications built with clean code and complete technical SEO.' },
        { icon:'<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>', title:'E-Commerce Development', slug:'ecommerce-development', desc:'Custom online stores with seamless Razorpay UPI checkout, automated inventory tracking, and order fulfillment.' },
        { icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>', title:'Custom Software Development', slug:'custom-software-development', desc:'Tailored business management systems, CRMs, and ERPs designed 100% around your specific operating workflow.' },
        { icon:'<rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>', title:'Mobile App Development', slug:'mobile-app-development', desc:'Cross-platform mobile apps for Android and iOS sharing real-time synchronized data with your central web platform.' },
        { icon:'<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>', title:'AI & Business Automation', slug:'ai-business-automation', desc:'Practical AI integration, automated WhatsApp leads, and document processing that saves your team hours of busywork.' },
        { icon:'<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>', title:'API Development & Integration', slug:'api-development', desc:'Secure REST APIs, payment webhooks, and third-party software connectors unifying your business tools.' },
      ];
      %>
      <% flagshipServices.forEach((s, i) => { %>
        <div class="svc-card fade-up fade-up-delay-<%= i % 3 %>">
          <div class="svc-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- s.icon %></svg>
