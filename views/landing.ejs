<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/jpeg" href="/stackifyx-logo.jpg">
  <script>if(localStorage.getItem('devcraft-theme')==='light')document.documentElement.classList.add('light');</script>

  <!-- SEO -->
  <title>StackifyX — Digital Product & Software Development Company</title>
  <meta name="description" content="StackifyX builds fast, secure and scalable websites, web applications, mobile apps and custom software. Transparent development from start to finish.">
  <meta name="keywords" content="web development, mobile app development, custom software, digital product studio, Node.js, React, MongoDB, API development">
  <link rel="canonical" href="<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>">

  <!-- Open Graph -->
  <meta property="og:type"        content="website">
  <meta property="og:url"         content="<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>">
  <meta property="og:title"       content="StackifyX — Digital Product & Software Development Company">
  <meta property="og:description" content="We build fast, secure and scalable websites, web applications, mobile apps and custom software with a transparent development experience.">
  <meta property="og:image"       content="<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/stackifyx-logo.jpg">
  <meta name="twitter:card"       content="summary_large_image">
  <meta name="twitter:title"      content="StackifyX — Digital Product & Software Development">
  <meta name="twitter:description" content="We build fast, secure and scalable digital products.">

  <!-- Schema.org -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/#organization",
        "name": "StackifyX",
        "url": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>",
        "logo": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/stackifyx-logo.jpg",
        "description": "StackifyX builds websites, web applications, mobile apps and custom software for businesses.",
        "address": { "@type": "PostalAddress", "addressCountry": "IN" },
        "sameAs": ["<%= locals.linkedinURL || '' %>"]
      },
      {
        "@type": "WebSite",
        "@id": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/#website",
        "url": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>",
        "name": "StackifyX",
        "publisher": { "@id": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/#organization" }
      }
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <style>
/* ═══════════════════════════════════════════════════════════
   LANDING PAGE — StackifyX Premium
═══════════════════════════════════════════════════════════ */
.lp-wrap { font-family:'Manrope',sans-serif; }
.lp-c    { max-width:1200px;margin:0 auto;padding:0 28px; }
.lp-section { padding:96px 0; }
.lp-section-alt { padding:96px 0;background:var(--bg-secondary);border-top:1px solid var(--border);border-bottom:1px solid var(--border); }

/* Label pill */
.lp-pill {
  display:inline-flex;align-items:center;gap:6px;
  padding:5px 14px;border-radius:100px;margin-bottom:18px;
  background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.2);
  font-size:0.72rem;font-weight:700;text-transform:uppercase;
  letter-spacing:0.1em;color:var(--accent-blue);
}
html.light .lp-pill { background:rgba(37,99,235,0.07); }

/* Section heading block */
.lp-heading { max-width:620px; }
.lp-heading.center { margin:0 auto;text-align:center; }
.lp-heading h2 {
  font-family:'Manrope',sans-serif;
  font-size:clamp(1.75rem,3vw,2.6rem);
  font-weight:800;letter-spacing:-0.03em;
  color:var(--text-primary);margin-bottom:14px;line-height:1.15;
}
.lp-heading p { font-size:1rem;color:var(--text-muted);line-height:1.75; }

/* ── HERO ──────────────────────────────────────────────── */
.hero {
  padding:calc(var(--nav-height) + 80px) 0 80px;
  min-height:100vh;display:flex;align-items:center;
  position:relative;overflow:hidden;
}
.hero-glow {
  position:absolute;pointer-events:none;border-radius:50%;z-index:0;
}
.hero-glow-a { top:-5%;left:-8%;width:700px;height:700px;
  background:radial-gradient(circle,rgba(37,99,235,0.07) 0%,transparent 65%); }
.hero-glow-b { bottom:-10%;right:-5%;width:550px;height:550px;
  background:radial-gradient(circle,rgba(124,58,237,0.06) 0%,transparent 65%); }

.hero-grid {
  position:relative;z-index:1;
  display:grid;grid-template-columns:1fr 1.05fr;gap:64px;align-items:center;
}

.hero-eyebrow {
  display:inline-flex;align-items:center;gap:8px;
  padding:6px 16px;border-radius:100px;margin-bottom:28px;
  background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.22);
  font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;
  color:var(--accent-blue);
}
.hero-h1 {
  font-family:'Manrope',sans-serif;
  font-size:clamp(2.4rem,4.5vw,3.6rem);
  font-weight:800;line-height:1.08;letter-spacing:-0.035em;
  color:var(--text-primary);margin-bottom:22px;
}
.hero-h1 .grad {
  background:linear-gradient(135deg,#2563eb,#7c3aed);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.hero-desc {
  font-size:1.05rem;color:var(--text-muted);line-height:1.8;
  margin-bottom:36px;max-width:460px;font-weight:400;
}
.hero-btns { display:flex;gap:14px;flex-wrap:wrap;margin-bottom:40px; }
.hero-tags { display:flex;flex-wrap:wrap;gap:8px; }
.hero-tag {
  display:inline-flex;align-items:center;gap:7px;padding:6px 14px;
  border-radius:100px;background:var(--bg-elevated);border:1px solid var(--border);
  font-size:0.78rem;font-weight:600;color:var(--text-muted);
}
.hero-tag svg { flex-shrink:0;color:var(--accent-blue); }

/* Dashboard mockup */
.dash-mockup {
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:18px;overflow:hidden;
  box-shadow:0 40px 80px rgba(0,0,0,0.4),0 0 0 1px rgba(255,255,255,0.04);
  animation:floatY 5s ease-in-out infinite;
}
html.light .dash-mockup { box-shadow:0 24px 64px rgba(37,99,235,0.1),0 1px 4px rgba(0,0,0,0.08); }
@keyframes floatY{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.dm-topbar {
  background:var(--bg-elevated);border-bottom:1px solid var(--border);
  padding:10px 18px;display:flex;align-items:center;justify-content:space-between;
}
.dm-dots { display:flex;gap:6px; }
.dm-dot  { width:10px;height:10px;border-radius:50%; }
.dm-user { display:flex;align-items:center;gap:8px;font-size:0.75rem;font-weight:700;color:var(--text-primary); }
.dm-av   { width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#7c3aed);display:flex;align-items:center;justify-content:center;font-size:0.6rem;font-weight:800;color:#fff; }
.dm-body { padding:18px; }
.dm-greet{ font-size:0.7rem;color:var(--text-muted);margin-bottom:2px; }
.dm-title{ font-family:'Manrope',sans-serif;font-size:0.88rem;font-weight:800;color:var(--text-primary);margin-bottom:16px; }
.dm-stats{ display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:16px; }
.dm-stat { background:var(--bg-elevated);border:1px solid var(--border);border-radius:9px;padding:10px 8px; }
.dm-sval { font-family:'Manrope',sans-serif;font-size:1.15rem;font-weight:800;color:var(--text-primary);line-height:1; }
.dm-slbl { font-size:0.58rem;color:var(--text-muted);margin-top:3px;font-weight:600;text-transform:uppercase;letter-spacing:0.04em; }
.dm-strd { font-size:0.58rem;font-weight:700;margin-top:3px; }
.dm-cols { display:grid;grid-template-columns:1.4fr 1fr;gap:10px; }
.dm-panel{ background:var(--bg-elevated);border:1px solid var(--border);border-radius:9px;padding:12px; }
.dm-ptitle{ font-size:0.68rem;font-weight:800;color:var(--text-primary);margin-bottom:10px;text-transform:uppercase;letter-spacing:0.05em; }
.dm-proj { margin-bottom:9px; }
.dm-pname{ font-size:0.68rem;font-weight:600;color:var(--text-primary);margin-bottom:4px; }
.dm-pbar { height:4px;background:var(--bg-card);border-radius:2px;overflow:hidden;margin-bottom:2px; }
.dm-pfill{ height:100%;border-radius:2px; }
.dm-pmeta{ font-size:0.58rem;color:var(--text-muted);display:flex;justify-content:space-between; }
.dm-act  { display:flex;align-items:flex-start;gap:6px;padding:5px 0;border-bottom:1px solid var(--border); }
.dm-act:last-child{border-bottom:none;}
.dm-adot { width:6px;height:6px;border-radius:50%;margin-top:4px;flex-shrink:0; }
.dm-atxt { font-size:0.62rem;color:var(--text-secondary);line-height:1.4; }
.dm-atime{ font-size:0.56rem;color:var(--text-muted);margin-top:2px; }

/* ── CRED STRIP ────────────────────────────────────────── */
.cred-strip { padding:28px 0;background:var(--bg-secondary);border-top:1px solid var(--border);border-bottom:1px solid var(--border); }
.cred-grid  { display:grid;grid-template-columns:repeat(4,1fr);gap:24px; }
.cred-item  { display:flex;align-items:flex-start;gap:14px; }
.cred-icon  {
  width:42px;height:42px;flex-shrink:0;border-radius:11px;
  background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.18);
  display:flex;align-items:center;justify-content:center;color:var(--accent-blue);
}
.cred-title{ font-size:0.9rem;font-weight:700;color:var(--text-primary);margin-bottom:3px; }
.cred-desc { font-size:0.78rem;color:var(--text-muted);line-height:1.45; }

/* ── SERVICES ──────────────────────────────────────────── */
.svc-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:20px; }
.svc-card {
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:16px;padding:28px;
  transition:border-color 0.2s,transform 0.2s,box-shadow 0.2s!important;
}
.svc-card:hover { border-color:var(--border-accent);transform:translateY(-4px);box-shadow:0 16px 48px rgba(37,99,235,0.1); }
.svc-icon {
  width:48px;height:48px;border-radius:12px;margin-bottom:20px;
  background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.18);
  display:flex;align-items:center;justify-content:center;color:var(--accent-blue);
  transition:background 0.2s,border-color 0.2s!important;
}
.svc-card:hover .svc-icon { background:rgba(37,99,235,0.15);border-color:rgba(37,99,235,0.35); }
.svc-title{ font-family:'Manrope',sans-serif;font-size:1rem;font-weight:700;color:var(--text-primary);margin-bottom:8px; }
.svc-desc { font-size:0.84rem;color:var(--text-muted);line-height:1.7;margin-bottom:16px; }
.svc-link { font-size:0.82rem;font-weight:700;color:var(--accent-blue);display:inline-flex;align-items:center;gap:4px;transition:gap 0.15s!important; }
.svc-card:hover .svc-link { gap:8px; }

/* ── PORTFOLIO ─────────────────────────────────────────── */
.port-header { display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:8px; }
.port-sub    { font-size:0.9rem;color:var(--text-muted);margin-bottom:44px; }
.port-grid   { display:grid;grid-template-columns:repeat(3,1fr);gap:24px; }
.port-card   {
  background:var(--bg-card);border:1px solid var(--border);border-radius:18px;
  overflow:hidden;transition:transform 0.2s,box-shadow 0.2s,border-color 0.2s!important;
}
.port-card:hover { transform:translateY(-5px);box-shadow:0 20px 56px rgba(0,0,0,0.2);border-color:var(--border-accent); }
.port-img {
  width:100%;height:190px;overflow:hidden;
  display:flex;align-items:center;justify-content:center;position:relative;
}
.port-body  { padding:22px; }
.port-name  { font-family:'Manrope',sans-serif;font-size:1rem;font-weight:800;color:var(--text-primary);margin-bottom:5px; }
.port-desc  { font-size:0.82rem;color:var(--text-muted);margin-bottom:14px;line-height:1.55; }
.port-tags  { display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px; }
.port-tag   { padding:3px 10px;border-radius:100px;background:var(--bg-elevated);border:1px solid var(--border);font-size:0.7rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace; }
.port-link  { font-size:0.82rem;font-weight:700;color:var(--accent-blue);display:inline-flex;align-items:center;gap:5px;transition:gap 0.15s!important; }
.port-card:hover .port-link { gap:9px; }

/* ── PROCESS ───────────────────────────────────────────── */
.proc-grid {
  display:grid;grid-template-columns:repeat(4,1fr);gap:0;
  background:var(--bg-card);border:1px solid var(--border);border-radius:20px;overflow:hidden;
}
.proc-step {
  padding:36px 28px;text-align:center;position:relative;
  border-right:1px solid var(--border);transition:background 0.2s!important;
}
.proc-step:last-child{border-right:none;}
.proc-step:hover{background:var(--bg-elevated);}
.proc-icon {
  width:52px;height:52px;margin:0 auto 16px;
  background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.2);
  border-radius:14px;display:flex;align-items:center;justify-content:center;
  color:var(--accent-blue);
}
.proc-num  { font-family:'JetBrains Mono',monospace;font-size:0.65rem;font-weight:700;color:var(--accent-blue);opacity:0.7;margin-bottom:6px;letter-spacing:0.05em; }
.proc-title{ font-family:'Manrope',sans-serif;font-size:1rem;font-weight:800;color:var(--text-primary);margin-bottom:8px; }
.proc-desc { font-size:0.82rem;color:var(--text-muted);line-height:1.65; }
.proc-arr  {
  position:absolute;right:-1px;top:50%;transform:translateY(-50%);
  width:24px;height:24px;background:var(--bg-elevated);border:1px solid var(--border);
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  color:var(--accent-blue);z-index:2;
}
.proc-step:last-child .proc-arr{display:none;}

/* ── WHY US ────────────────────────────────────────────── */
.why-grid  { display:grid;grid-template-columns:repeat(3,1fr);gap:18px; }
.why-card  {
  background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:28px;
  transition:border-color 0.2s,transform 0.2s!important;
}
.why-card:hover { border-color:var(--border-accent);transform:translateY(-3px); }
.why-icon  {
  width:44px;height:44px;border-radius:12px;margin-bottom:16px;
  background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.18);
  display:flex;align-items:center;justify-content:center;color:var(--accent-blue);
}
.why-title { font-family:'Manrope',sans-serif;font-size:0.95rem;font-weight:800;color:var(--text-primary);margin-bottom:8px; }
.why-desc  { font-size:0.82rem;color:var(--text-muted);line-height:1.65; }

/* ── TECH STRIP ────────────────────────────────────────── */
.tech-strip { display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:40px; }
.tech-badge {
  display:inline-flex;align-items:center;gap:8px;
  padding:10px 18px;border-radius:12px;
  background:var(--bg-card);border:1px solid var(--border);
  font-size:0.84rem;font-weight:700;color:var(--text-secondary);
  transition:border-color 0.15s,color 0.15s,transform 0.15s!important;
}
.tech-badge:hover { border-color:var(--border-accent);color:var(--accent-blue);transform:translateY(-2px); }

/* ── ABOUT ─────────────────────────────────────────────── */
.about-grid { display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center; }
.about-checklist { margin-top:24px;display:flex;flex-direction:column;gap:12px; }
.about-check {
  display:flex;align-items:flex-start;gap:12px;
  font-size:0.88rem;color:var(--text-secondary);line-height:1.6;
}
.about-check-icon {
  width:22px;height:22px;flex-shrink:0;background:rgba(37,99,235,0.1);
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  color:var(--accent-blue);margin-top:1px;
}
.about-visual {
  background:var(--bg-card);border:1px solid var(--border);border-radius:20px;
  padding:36px;position:relative;overflow:hidden;
}
.about-vis-item {
  display:flex;align-items:center;gap:14px;padding:16px;
  background:var(--bg-elevated);border:1px solid var(--border);border-radius:12px;margin-bottom:12px;
  transition:border-color 0.15s!important;
}
.about-vis-item:hover { border-color:var(--border-accent); }
.about-vis-icon {
  width:40px;height:40px;flex-shrink:0;border-radius:10px;
  background:rgba(37,99,235,0.1);border:1px solid rgba(37,99,235,0.2);
  display:flex;align-items:center;justify-content:center;color:var(--accent-blue);
}
.about-vis-title { font-size:0.88rem;font-weight:700;color:var(--text-primary);margin-bottom:2px; }
.about-vis-sub   { font-size:0.75rem;color:var(--text-muted); }

/* ── INDUSTRIES ────────────────────────────────────────── */
.ind-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:14px; }
.ind-card {
  background:var(--bg-card);border:1px solid var(--border);border-radius:14px;
  padding:20px 16px;display:flex;align-items:center;gap:12px;
  transition:border-color 0.15s,background 0.15s,transform 0.15s!important;
}
.ind-card:hover { border-color:var(--border-accent);background:var(--bg-elevated);transform:translateY(-2px); }
.ind-icon {
  width:36px;height:36px;flex-shrink:0;border-radius:9px;
  background:var(--bg-elevated);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;color:var(--accent-blue);
}
.ind-name  { font-size:0.86rem;font-weight:700;color:var(--text-primary); }

/* ── CTA ───────────────────────────────────────────────── */
.cta-box {
  background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 45%,#7c3aed 100%);
  border-radius:28px;padding:80px 64px;text-align:center;
  position:relative;overflow:hidden;
}
.cta-glow-1 { position:absolute;top:-80px;left:-80px;width:320px;height:320px;border-radius:50%;background:rgba(255,255,255,0.05);pointer-events:none; }
.cta-glow-2 { position:absolute;bottom:-80px;right:-80px;width:280px;height:280px;border-radius:50%;background:rgba(255,255,255,0.04);pointer-events:none; }
.cta-title {
  font-family:'Manrope',sans-serif;
  font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:800;
  color:#fff;margin-bottom:14px;letter-spacing:-0.025em;position:relative;z-index:1;
}
.cta-desc  { font-size:1rem;color:rgba(255,255,255,0.78);max-width:520px;margin:0 auto 36px;line-height:1.75;position:relative;z-index:1; }
.cta-btns  { display:flex;gap:14px;justify-content:center;flex-wrap:wrap;position:relative;z-index:1; }
.cta-btn-p {
  display:inline-flex;align-items:center;gap:8px;padding:14px 28px;
  background:#fff;border-radius:10px;color:#1e40af;font-weight:700;font-size:0.93rem;
  text-decoration:none;transition:transform 0.15s,box-shadow 0.15s!important;
}
.cta-btn-p:hover { transform:translateY(-2px);box-shadow:0 10px 28px rgba(0,0,0,0.25);color:#1e40af; }
.cta-btn-s {
  display:inline-flex;align-items:center;gap:8px;padding:13px 28px;
  background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.3);
  border-radius:10px;color:#fff;font-weight:600;font-size:0.93rem;
  text-decoration:none;transition:background 0.15s!important;
}
.cta-btn-s:hover { background:rgba(255,255,255,0.2);color:#fff; }

/* ── FOOTER ────────────────────────────────────────────── */
.lp-footer { background:#0a0e17;border-top:1px solid rgba(255,255,255,0.06);padding:72px 0 32px; }
.foot-grid { display:grid;grid-template-columns:1.8fr 1fr 1fr 1fr 1fr;gap:40px;margin-bottom:56px; }
.foot-logo-row { display:flex;align-items:center;gap:10px;margin-bottom:12px; }
.foot-brand-name { font-family:'Manrope',sans-serif;font-size:1.1rem;font-weight:800;color:#f8fafc; }
.foot-brand-accent { color:#63b3ed; }
.foot-desc { font-size:0.84rem;color:#64748b;line-height:1.75;margin-bottom:22px;max-width:230px; }
.foot-socials { display:flex;gap:8px; }
.foot-social {
  width:34px;height:34px;border-radius:9px;border:1px solid rgba(255,255,255,0.08);
  background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;
  color:#64748b;text-decoration:none;transition:background 0.15s,border-color 0.15s,color 0.15s!important;
}
.foot-social:hover { background:rgba(37,99,235,0.2);border-color:rgba(37,99,235,0.4);color:#93c5fd; }
.foot-col-title { font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:#94a3b8;margin-bottom:18px; }
.foot-link { display:flex;align-items:center;gap:6px;font-size:0.84rem;color:#64748b;text-decoration:none;padding:4px 0;transition:color 0.15s!important; }
.foot-link:hover { color:#e2e8f0; }
.foot-bottom {
  padding-top:24px;border-top:1px solid rgba(255,255,255,0.06);
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;
}
.foot-bottom p { font-size:0.78rem;color:#475569; }

/* ── RESPONSIVE ────────────────────────────────────────── */
@media(max-width:1100px){
  .hero-grid   { grid-template-columns:1fr;gap:52px; }
  .dash-mockup { max-width:580px;margin:0 auto;animation:none; }
  .svc-grid    { grid-template-columns:repeat(2,1fr); }
  .port-grid   { grid-template-columns:repeat(2,1fr); }
  .proc-grid   { grid-template-columns:repeat(2,1fr);border-radius:16px; }
  .proc-step   { border-right:none;border-bottom:1px solid var(--border); }
  .proc-step:nth-child(odd)  { border-right:1px solid var(--border); }
  .proc-step:last-child,.proc-step:nth-last-child(2) { border-bottom:none; }
  .proc-arr    { display:none; }
  .why-grid    { grid-template-columns:repeat(2,1fr); }
  .about-grid  { grid-template-columns:1fr; }
  .ind-grid    { grid-template-columns:repeat(2,1fr); }
  .foot-grid   { grid-template-columns:repeat(2,1fr); }
  .cred-grid   { grid-template-columns:repeat(2,1fr); }
  .dm-stats    { grid-template-columns:repeat(2,1fr); }
  .dm-cols     { grid-template-columns:1fr; }
}
@media(max-width:640px){
  .lp-section,.lp-section-alt { padding:64px 0; }
  .svc-grid   { grid-template-columns:1fr; }
  .port-grid  { grid-template-columns:1fr; }
  .why-grid   { grid-template-columns:1fr; }
  .ind-grid   { grid-template-columns:repeat(2,1fr); }
  .foot-grid  { grid-template-columns:1fr 1fr; }
  .cta-box    { padding:52px 24px; }
  .cta-btns   { flex-direction:column;align-items:center; }
}
</style>
</head>

