<!DOCTYPE html>
<html lang="en">
<head>
  <% locals.canonicalPath = '/'; %>
  <%- include('partials/page-head') %>

  <!-- Homepage FAQ Schema -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How does StackifyX work with clients across India?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "StackifyX collaborates remotely with businesses across all Indian states and cities using weekly video sprint reviews, live staging environments, direct WhatsApp communication, and our proprietary client dashboard for milestone and invoice tracking."
        }
      },
      {
        "@type": "Question",
        "name": "How much does a professional website cost in India?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Website development typically starts from ₹15,000 for standard business sites and ranges upwards for advanced e-commerce stores, custom web apps, and SaaS platforms. We provide clear, fixed-price milestone estimates before starting."
        }
      },
      {
        "@type": "Question",
        "name": "Do I own the source code of my website or software?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, 100%. Upon project completion and final payment, you receive full ownership of your source code, database architecture, and digital assets with zero vendor lock-in."
        }
      },
      {
        "@type": "Question",
        "name": "Do you provide post-launch support and maintenance?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Every project includes post-launch warranty, security monitoring, and ongoing maintenance options managed directly through your client dashboard."
        }
      }
    ]
  }) %>
  </script>
</head>

<body class="lp-wrap">
