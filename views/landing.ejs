<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/jpeg" href="/stackifyx-logo.jpg">
  <script>if(localStorage.getItem('devcraft-theme')==='light')document.documentElement.classList.add('light');</script>
  <title>StackifyX — We Build Digital Products That Move Businesses Forward</title>
  <meta name="description" content="From websites and web applications to custom software and mobile apps, StackifyX turns your ideas into reliable, scalable digital products.">
  <!-- Preload Syne font so hero title renders correctly on first paint -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* ═══════════════════════════════════════════════
       LANDING PAGE STYLES
    ═══════════════════════════════════════════════ */

    /* Sections */
    .lp-section { padding: 96px 0; }
    .lp-section-sm { padding: 64px 0; }

    /* Section label */
    .lp-label {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 16px; border-radius: 100px;
      background: rgba(99,179,237,0.08);
      border: 1px solid rgba(99,179,237,0.2);
      font-size: 0.75rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--accent-blue); margin-bottom: 20px;
    }
    html.light .lp-label {
      background: rgba(37,99,235,0.07);
      border-color: rgba(37,99,235,0.2);
    }

    /* ── HERO ───────────────────────────────────── */
    .hero {
      min-height: 100vh;
      padding: calc(var(--nav-height) + 80px) 0 80px;
      display: flex; align-items: center;
      position: relative; overflow: hidden;
    }
    .hero-glow {
      position: absolute; pointer-events: none; z-index: 0;
    }
    .hero-glow-1 {
      top: 10%; left: -5%;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(99,179,237,0.07) 0%, transparent 70%);
    }
    .hero-glow-2 {
      bottom: 5%; right: -5%;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(167,139,250,0.06) 0%, transparent 70%);
    }
    .hero-inner {
      position: relative; z-index: 1;
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 64px; align-items: center;
    }
    .hero-title {
      font-family: 'Syne', var(--font-display), sans-serif; /* explicit — prevents fallback font */
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 800; line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--text-primary);
      margin-bottom: 20px;
    }
    .hero-title .grad {
      font-family: inherit;
      font-weight: 800;
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      /* Fallback for browsers that don't support bg-clip */
      color: var(--accent-blue);
    }
    .hero-desc {
      font-size: 1.05rem; color: var(--text-muted);
      line-height: 1.75; margin-bottom: 36px;
      max-width: 480px;
    }
    .hero-btns { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 40px; }
    .hero-tags {
      display: flex; flex-wrap: wrap; gap: 8px;
    }
    .hero-tag {
      padding: 5px 14px;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 100px;
      font-size: 0.78rem; font-weight: 600;
      color: var(--text-muted);
    }

    /* Dashboard mockup */
    .hero-mockup {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 20px;
      overflow: visible; /* was 'hidden' — was clipping the revenue chart */
      box-shadow: 0 32px 80px rgba(0,0,0,0.4);
      animation: floatY 4s ease-in-out infinite;
    }
    /* Inner body can scroll on small screens but never clips */
    .mockup-body {
      padding: 20px;
      overflow: visible;
    }
    html.light .hero-mockup { box-shadow: 0 32px 80px rgba(0,0,0,0.12); }
    @keyframes floatY {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-10px); }
    }
    .mockup-bar {
      padding: 12px 16px;
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 8px;
    }
    .mockup-dot { width: 10px; height: 10px; border-radius: 50%; }
    .mockup-title {
      font-size: 0.8rem; font-weight: 600;
      color: var(--text-muted); margin-left: 4px;
    }
    /* mockup-body defined above */
    .mockup-stat-row {
      display: grid; grid-template-columns: repeat(2, 1fr);
      gap: 10px; margin-bottom: 18px;
    }
    .mockup-stat {
      background: var(--bg-elevated);
      border-radius: 10px; padding: 12px;
      border: 1px solid var(--border);
    }
    .mockup-stat-val {
      font-family: var(--font-display);
      font-size: 1.3rem; font-weight: 800;
      color: var(--text-primary); line-height: 1;
    }
    .mockup-stat-lbl { font-size: 0.68rem; color: var(--text-muted); margin-top: 3px; }
    .mockup-project {
      background: var(--bg-elevated);
      border-radius: 10px; padding: 12px 14px;
      border: 1px solid var(--border);
      margin-bottom: 8px;
    }
    .mockup-proj-top {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 8px;
    }
    .mockup-proj-name {
      font-size: 0.82rem; font-weight: 600; color: var(--text-primary);
    }
    .mockup-prog-bar {
      height: 5px; background: var(--bg-card);
      border-radius: 3px; overflow: hidden; margin-bottom: 5px;
    }
    .mockup-prog-fill {
      height: 100%; border-radius: 3px;
      background: var(--gradient-primary);
    }
    .mockup-prog-lbl {
      display: flex; justify-content: space-between;
      font-size: 0.65rem; color: var(--text-muted);
    }

    /* ── CREDIBILITY STRIP ──────────────────────── */
    .cred-strip {
      padding: 28px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: var(--bg-secondary);
    }
    html.light .cred-strip { background: #eceef5; }
    .cred-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .cred-item {
      display: flex; align-items: flex-start; gap: 12px;
    }
    .cred-icon {
      width: 40px; height: 40px; flex-shrink: 0;
      background: rgba(99,179,237,0.1);
      border: 1px solid rgba(99,179,237,0.2);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      color: var(--accent-blue);
    }
    .cred-title {
      font-size: 0.88rem; font-weight: 700;
      color: var(--text-primary); margin-bottom: 2px;
    }
    .cred-desc { font-size: 0.78rem; color: var(--text-muted); line-height: 1.4; }

    /* ── STATS BAR ──────────────────────────────── */
    .stats-bar {
      display: grid; grid-template-columns: repeat(4,1fr);
      gap: 1px; background: var(--border);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg); overflow: hidden;
    }
    .stats-bar-item {
      background: var(--bg-card);
      padding: 32px 24px; text-align: center;
    }
    .stats-bar-num {
      font-family: var(--font-display);
      font-size: 2.4rem; font-weight: 800;
      background: var(--gradient-primary);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text; line-height: 1; margin-bottom: 6px;
    }
    .stats-bar-lbl { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; }

    /* ── SERVICES ───────────────────────────────── */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .service-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 28px;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
      cursor: default;
    }
    .service-card:hover {
      border-color: var(--border-accent);
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
    }
    .svc-icon {
      width: 48px; height: 48px;
      background: rgba(99,179,237,0.1);
      border: 1px solid rgba(99,179,237,0.2);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      color: var(--accent-blue);
      margin-bottom: 18px;
      transition: background 0.2s, border-color 0.2s;
    }
    .service-card:hover .svc-icon {
      background: rgba(99,179,237,0.18);
      border-color: rgba(99,179,237,0.4);
    }
    .svc-title {
      font-family: var(--font-display);
      font-size: 1rem; font-weight: 700;
      color: var(--text-primary); margin-bottom: 8px;
    }
    .svc-desc { font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; }

    /* ── PROCESS ────────────────────────────────── */
    .process-grid {
      display: grid; grid-template-columns: repeat(4,1fr); gap: 24px;
      position: relative;
    }
    .process-grid::before {
      content: '';
      position: absolute; top: 28px; left: 10%; right: 10%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border-accent), transparent);
    }
    .process-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 28px 24px;
      text-align: center;
      position: relative; z-index: 1;
      transition: border-color 0.2s, transform 0.2s;
    }
    .process-card:hover { border-color: var(--border-accent); transform: translateY(-4px); }
    .process-num {
      width: 52px; height: 52px; border-radius: 50%;
      background: var(--gradient-primary);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono); font-size: 1rem; font-weight: 700;
      color: #fff; margin: 0 auto 18px;
      box-shadow: 0 8px 24px rgba(99,179,237,0.3);
    }
    .process-title {
      font-family: var(--font-display); font-size: 1rem; font-weight: 700;
      color: var(--text-primary); margin-bottom: 8px;
    }
    .process-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; }

    /* ── WHY US ─────────────────────────────────── */
    .why-grid {
      display: grid; grid-template-columns: repeat(2,1fr); gap: 20px;
    }
    .why-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 32px;
      display: flex; gap: 20px;
      transition: border-color 0.2s, transform 0.2s;
    }
    .why-card:hover { border-color: var(--border-accent); transform: translateY(-3px); }
    .why-num {
      font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700;
      color: var(--accent-blue); opacity: 0.7;
      min-width: 28px; padding-top: 2px;
    }
    .why-title {
      font-family: var(--font-display); font-size: 1rem; font-weight: 700;
      color: var(--text-primary); margin-bottom: 8px;
    }
    .why-desc { font-size: 0.875rem; color: var(--text-muted); line-height: 1.65; }

    /* ── INDUSTRIES ─────────────────────────────── */
    .industries-grid {
      display: grid; grid-template-columns: repeat(4,1fr); gap: 14px;
    }
    .industry-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 20px 18px;
      display: flex; align-items: center; gap: 12px;
      transition: border-color 0.2s, background 0.2s;
    }
    .industry-card:hover {
      border-color: var(--border-accent);
      background: var(--bg-card-hover);
    }
    .industry-icon {
      width: 36px; height: 36px; flex-shrink: 0;
      background: var(--bg-elevated);
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      color: var(--accent-blue);
    }
    .industry-name {
      font-size: 0.88rem; font-weight: 600; color: var(--text-primary);
    }

    /* ── CTA ────────────────────────────────────── */
    .cta-box {
      position: relative; overflow: hidden;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 80px 64px;
      text-align: center;
    }
    .cta-glow-1 {
      position: absolute; top: -60px; left: -60px;
      width: 300px; height: 300px; border-radius: 50%;
      background: radial-gradient(circle, rgba(99,179,237,0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .cta-glow-2 {
      position: absolute; bottom: -60px; right: -60px;
      width: 300px; height: 300px; border-radius: 50%;
      background: radial-gradient(circle, rgba(167,139,250,0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .cta-title {
      font-size: clamp(1.8rem, 3.5vw, 2.8rem);
      font-weight: 800; letter-spacing: -0.03em;
      margin-bottom: 16px; position: relative; z-index: 1;
    }
    .cta-desc {
      font-size: 1.05rem; color: var(--text-muted);
      max-width: 520px; margin: 0 auto 36px;
      line-height: 1.75; position: relative; z-index: 1;
    }
    .cta-btns {
      display: flex; gap: 14px; justify-content: center;
      flex-wrap: wrap; position: relative; z-index: 1;
    }

    /* ── FOOTER ─────────────────────────────────── */
    .lp-footer {
      background: var(--bg-secondary);
      border-top: 1px solid var(--border);
      padding: 64px 0 32px;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 48px; margin-bottom: 48px;
    }
    .footer-brand-desc {
      font-size: 0.88rem; color: var(--text-muted);
      line-height: 1.7; margin: 14px 0 20px;
      max-width: 260px;
    }
    .footer-col-title {
      font-size: 0.72rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--text-muted); margin-bottom: 16px;
    }
    .footer-link {
      display: block; font-size: 0.88rem;
      color: var(--text-secondary); text-decoration: none;
      padding: 4px 0; transition: color 0.15s;
    }
    .footer-link:hover { color: var(--accent-blue); }
    .footer-bottom {
      padding-top: 24px; border-top: 1px solid var(--border);
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 12px;
    }
    .footer-bottom p { font-size: 0.82rem; color: var(--text-muted); }

    /* ── RESPONSIVE ──────────────────────────────── */
    @media (max-width: 1024px) {
      .hero-inner    { grid-template-columns: 1fr; gap: 48px; }
      .hero-mockup   { max-width: 560px; margin: 0 auto; animation: none; }
      .services-grid { grid-template-columns: repeat(2,1fr); }
      .process-grid  { grid-template-columns: repeat(2,1fr); }
      .process-grid::before { display: none; }
      .why-grid      { grid-template-columns: 1fr; }
      .industries-grid { grid-template-columns: repeat(2,1fr); }
      .footer-grid   { grid-template-columns: 1fr 1fr; }
      .cred-grid     { grid-template-columns: repeat(2,1fr); }
      .stats-bar     { grid-template-columns: repeat(2,1fr); }
      .cta-box       { padding: 56px 32px; }
    }
    @media (max-width: 640px) {
      .lp-section    { padding: 64px 0; }
      .services-grid { grid-template-columns: 1fr; }
      .process-grid  { grid-template-columns: 1fr; }
      .industries-grid { grid-template-columns: repeat(2,1fr); }
      .footer-grid   { grid-template-columns: 1fr; gap: 32px; }
      .stats-bar     { grid-template-columns: repeat(2,1fr); }
      .cta-box       { padding: 48px 24px; }
      .cta-btns      { flex-direction: column; align-items: center; }
    }
  </style>
</head>
<body>
<%- include('partials/navbar') %>

<!-- ═══════════════════════ HERO ═══════════════════════════════ -->
<section class="hero">
  <div class="hero-glow hero-glow-1"></div>
  <div class="hero-glow hero-glow-2"></div>
  <div class="container">
    <div class="hero-inner">

      <!-- Left: copy -->
      <div>
        <div class="lp-label">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Digital Product Studio
        </div>

        <h1 class="hero-title">
          We Build Digital Products<br>
          That <span class="grad">Move Businesses</span><br>
          Forward.
        </h1>

        <p class="hero-desc">
          From websites and web applications to custom software and mobile apps,
          StackifyX turns your ideas into reliable, scalable digital products.
        </p>

        <div class="hero-btns">
          <a href="/auth/register" class="btn btn-primary btn-lg">Start a Project →</a>
          <a href="#services" class="btn btn-secondary btn-lg">View Our Work</a>
        </div>

        <div class="hero-tags">
          <span class="hero-tag">Web Development</span>
          <span class="hero-tag">Mobile Apps</span>
          <span class="hero-tag">Custom Software</span>
          <span class="hero-tag">API Development</span>
        </div>
      </div>

      <!-- Right: dashboard mockup -->
      <div>
        <div class="hero-mockup">
          <div class="mockup-bar">
            <div class="mockup-dot" style="background:#ff5f57;"></div>
            <div class="mockup-dot" style="background:#febc2e;"></div>
            <div class="mockup-dot" style="background:#28c840;"></div>
            <span class="mockup-title">StackifyX — Project Dashboard</span>
          </div>
          <div class="mockup-body">
            <!-- Stats row -->
            <div class="mockup-stat-row">
              <div class="mockup-stat">
                <div class="mockup-stat-val" style="color:var(--accent-blue);">12</div>
                <div class="mockup-stat-lbl">Active Projects</div>
              </div>
              
              <div class="mockup-stat">
                <div class="mockup-stat-val" style="color:var(--accent-green);">8</div>
                <div class="mockup-stat-lbl">Completed</div>
