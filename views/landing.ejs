<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/jpeg" href="/stackifyx-logo.jpg">
  <script>if(localStorage.getItem('devcraft-theme')==='light')document.documentElement.classList.add('light');</script>
  <title>StackifyX — We Build Digital Products That Move Businesses Forward</title>
  <meta name="description" content="From websites and web apps to custom software and mobile apps, StackifyX turns your ideas into reliable, scalable digital products.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
/* ══════════════════════════════════════════════════════════════
   LANDING PAGE — Full redesign matching StackifyX screenshot
══════════════════════════════════════════════════════════════ */

/* CSS Variables override for landing — light-first design */
.lp { --lp-text: var(--text-primary); --lp-muted: var(--text-muted); }

/* Smooth section scroll */
html { scroll-behavior: smooth; }

/* ── Utilities ──────────────────────────────────────────────── */
.lp-container { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
.lp-label {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 14px; border-radius: 100px;
  background: rgba(99,179,237,0.1); border: 1px solid rgba(99,179,237,0.25);
  font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.1em; color: var(--accent-blue); margin-bottom: 16px;
}
.lp-section { padding: 88px 0; }
.lp-section-alt {
  padding: 88px 0;
  background: var(--bg-secondary);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.section-center { text-align: center; max-width: 600px; margin: 0 auto 56px; }
.section-center h2 { font-family:'Syne',sans-serif; font-size:clamp(1.6rem,3vw,2.2rem); font-weight:800; letter-spacing:-0.02em; margin-bottom:12px; }
.section-center p  { font-size:1rem; color:var(--text-muted); line-height:1.75; }

/* ── HERO ───────────────────────────────────────────────────── */
.hero {
  padding: calc(var(--nav-height) + 72px) 0 72px;
  min-height: 100vh; display: flex; align-items: center;
  position: relative; overflow: hidden;
}
.hero-bg-glow {
  position: absolute; pointer-events: none; z-index: 0;
  border-radius: 50%;
}
.hero-glow-1 { top:-10%;left:-5%; width:600px;height:600px;
  background:radial-gradient(circle,rgba(99,179,237,0.07) 0%,transparent 70%); }
.hero-glow-2 { bottom:0;right:-5%; width:500px;height:500px;
  background:radial-gradient(circle,rgba(167,139,250,0.06) 0%,transparent 70%); }

.hero-grid {
  position: relative; z-index: 1;
  display: grid; grid-template-columns: 1fr 1.1fr;
  gap: 56px; align-items: center;
}
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 5px 14px; border-radius: 100px;
  background: rgba(99,179,237,0.09); border: 1px solid rgba(99,179,237,0.22);
  font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.1em; color: var(--accent-blue); margin-bottom: 24px;
}
.hero-title {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2.2rem, 4.2vw, 3.2rem);
  font-weight: 800; line-height: 1.08;
  letter-spacing: -0.03em; color: var(--text-primary);
  margin-bottom: 20px;
}
.hero-title .grad {
  font-family: inherit; font-weight: 800;
  background: var(--gradient-primary);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.hero-desc { font-size: 1rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 32px; max-width: 440px; }
.hero-btns { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 36px; }
.hero-tags { display: flex; flex-wrap: wrap; gap: 8px; }
.hero-tag {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 14px; border-radius: 100px;
  background: var(--bg-elevated); border: 1px solid var(--border);
  font-size: 0.78rem; font-weight: 600; color: var(--text-muted);
}
.hero-tag::before { content:''; width:7px;height:7px;border-radius:50%;background:var(--accent-blue); }

/* Dashboard mockup */
.mockup-wrap {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 32px 72px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,255,255,0.04);
  animation: floatY 5s ease-in-out infinite;
}
html.light .mockup-wrap { box-shadow: 0 24px 64px rgba(37,99,235,0.1), 0 1px 4px rgba(0,0,0,0.08); }
@keyframes floatY { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }

.mockup-topbar {
  background: var(--bg-elevated); border-bottom: 1px solid var(--border);
  padding: 10px 16px; display: flex; align-items: center; justify-content: space-between;
}
.mockup-dots { display:flex; gap:6px; }
.mockup-dot { width:9px;height:9px;border-radius:50%; }
.mockup-user {
  display: flex; align-items: center; gap: 8px;
  font-size: 0.75rem; font-weight: 600; color: var(--text-primary);
}
.mockup-avatar-sm {
  width: 24px; height: 24px; border-radius: 50%;
  background: var(--gradient-primary);
  display:flex;align-items:center;justify-content:center;
  font-size:0.6rem;font-weight:800;color:#fff;
}
.mockup-body { padding: 16px; }
.mockup-greeting { font-size:0.72rem;color:var(--text-muted);margin-bottom:2px; }
.mockup-title-sm { font-family:'Syne',sans-serif;font-size:0.88rem;font-weight:700;color:var(--text-primary);margin-bottom:14px; }

.mockup-stats-row { display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:16px; }
.mockup-stat-card {
  background:var(--bg-elevated);border:1px solid var(--border);border-radius:8px;padding:10px;
}
.mockup-stat-num { font-family:'Syne',sans-serif;font-size:1.15rem;font-weight:800;color:var(--text-primary);line-height:1; }
.mockup-stat-lbl { font-size:0.6rem;color:var(--text-muted);margin-top:3px;font-weight:500; }
.mockup-stat-trend { font-size:0.58rem;color:var(--accent-green);font-weight:600;margin-top:2px; }

.mockup-two-col { display:grid;grid-template-columns:1.3fr 1fr;gap:10px; }
.mockup-panel {
  background:var(--bg-elevated);border:1px solid var(--border);border-radius:8px;padding:12px;
}
.mockup-panel-title { font-size:0.7rem;font-weight:700;color:var(--text-primary);margin-bottom:10px; }
.mockup-proj-item { margin-bottom:8px; }
.mockup-proj-name { font-size:0.68rem;font-weight:600;color:var(--text-primary);margin-bottom:4px; }
.mockup-proj-bar { height:4px;background:var(--bg-card);border-radius:2px;overflow:hidden;margin-bottom:2px; }
.mockup-proj-fill { height:100%;border-radius:2px;background:var(--gradient-primary); }
.mockup-proj-meta { display:flex;justify-content:space-between;font-size:0.58rem;color:var(--text-muted); }
.mockup-activity-item {
  display:flex;align-items:flex-start;gap:6px;padding:4px 0;
  border-bottom:1px solid var(--border);
}
.mockup-activity-item:last-child{border-bottom:none;}
.mockup-act-dot { width:6px;height:6px;border-radius:50%;background:var(--accent-blue);margin-top:3px;flex-shrink:0; }
.mockup-act-text { font-size:0.62rem;color:var(--text-secondary);line-height:1.4; }
.mockup-act-time { font-size:0.58rem;color:var(--text-muted);margin-top:1px; }

/* ── CRED STRIP ─────────────────────────────────────────────── */
.cred-strip { padding:24px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--bg-secondary); }
.cred-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:20px; }
.cred-item { display:flex;align-items:center;gap:12px; }
.cred-icon-wrap {
  width:38px;height:38px;flex-shrink:0;
  background:rgba(99,179,237,0.08);border:1px solid rgba(99,179,237,0.2);
  border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--accent-blue);
}
.cred-title { font-size:0.85rem;font-weight:700;color:var(--text-primary);margin-bottom:2px; }
.cred-desc  { font-size:0.74rem;color:var(--text-muted);line-height:1.35; }

/* ── SERVICES ───────────────────────────────────────────────── */
.svc-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:28px; }
.svc-card {
  padding:0;display:flex;align-items:flex-start;gap:16px;
}
.svc-icon-wrap {
  width:44px;height:44px;flex-shrink:0;
  background:rgba(99,179,237,0.08);border:1px solid rgba(99,179,237,0.2);
  border-radius:11px;display:flex;align-items:center;justify-content:center;
  color:var(--accent-blue);transition:background 0.2s,border-color 0.2s;
}
.svc-card:hover .svc-icon-wrap { background:rgba(99,179,237,0.16);border-color:rgba(99,179,237,0.4); }
.svc-title { font-family:'Syne',sans-serif;font-size:0.95rem;font-weight:700;color:var(--text-primary);margin-bottom:6px; }
.svc-desc  { font-size:0.83rem;color:var(--text-muted);line-height:1.65; }

/* ── PORTFOLIO ──────────────────────────────────────────────── */
.portfolio-header { display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:8px; }
.portfolio-sub { font-size:0.88rem;color:var(--text-muted);margin-bottom:40px; }
.portfolio-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:24px; }
.portfolio-card {
  background:var(--bg-card);border:1px solid var(--border);border-radius:16px;
  overflow:hidden;transition:transform 0.2s,box-shadow 0.2s,border-color 0.2s;cursor:pointer;
}
.portfolio-card:hover { transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:var(--border-accent); }
.portfolio-img {
  width:100%;height:180px;object-fit:cover;background:var(--bg-elevated);
  display:flex;align-items:center;justify-content:center;overflow:hidden;
  position:relative;
}
.portfolio-img-placeholder {
  width:100%;height:180px;
  display:flex;align-items:center;justify-content:center;
  position:relative;overflow:hidden;
}
.portfolio-body { padding:20px; }
.portfolio-name { font-family:'Syne',sans-serif;font-size:1rem;font-weight:700;color:var(--text-primary);margin-bottom:4px; }
.portfolio-desc { font-size:0.82rem;color:var(--text-muted);margin-bottom:14px;line-height:1.55; }
.portfolio-tags { display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px; }
.portfolio-tag {
  padding:3px 10px;border-radius:100px;background:var(--bg-elevated);
  border:1px solid var(--border);font-size:0.72rem;color:var(--text-muted);
  font-family:var(--font-mono);font-weight:500;
}
.portfolio-link { font-size:0.82rem;font-weight:700;color:var(--accent-blue);text-decoration:none;transition:color 0.15s; }
.portfolio-link:hover { color:var(--accent-purple); }

/* ── PROCESS ────────────────────────────────────────────────── */
.process-flow {
  display:grid;grid-template-columns:repeat(4,1fr);
  align-items:start;gap:0;position:relative;
}
.process-step { text-align:center;padding:0 16px;position:relative; }
.process-step:not(:last-child)::after {
  content:'→';
  position:absolute;right:-14px;top:18px;
  font-size:1rem;color:var(--border-accent);line-height:1;
}
.process-icon-wrap {
  width:44px;height:44px;margin:0 auto 14px;
  background:rgba(99,179,237,0.08);border:1px solid rgba(99,179,237,0.2);
  border-radius:11px;display:flex;align-items:center;justify-content:center;
  color:var(--accent-blue);
}
.process-num-lbl { font-family:var(--font-mono);font-size:0.65rem;font-weight:700;color:var(--accent-blue);opacity:0.7;margin-bottom:4px; }
.process-title { font-family:'Syne',sans-serif;font-size:0.9rem;font-weight:700;color:var(--text-primary);margin-bottom:6px; }
.process-desc  { font-size:0.8rem;color:var(--text-muted);line-height:1.6; }

/* ── WHY US ─────────────────────────────────────────────────── */
.why-layout { display:grid;grid-template-columns:1fr 1.5fr;gap:64px;align-items:start; }
.why-left-title { font-family:'Syne',sans-serif;font-size:clamp(1.8rem,3vw,2.6rem);font-weight:800;letter-spacing:-0.03em;margin-bottom:16px; }
.why-left-title span { color:var(--accent-blue); }
.why-left-desc { font-size:0.9rem;color:var(--text-muted);line-height:1.75;margin-bottom:28px; }
.why-features { display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:32px; }
.why-feat {
  background:var(--bg-card);border:1px solid var(--border);border-radius:14px;
  padding:18px 14px;text-align:center;transition:border-color 0.2s,transform 0.2s;
}
.why-feat:hover { border-color:var(--border-accent);transform:translateY(-2px); }
.why-feat-icon {
  width:40px;height:40px;margin:0 auto 10px;
  background:rgba(99,179,237,0.08);border:1px solid rgba(99,179,237,0.2);
  border-radius:10px;display:flex;align-items:center;justify-content:center;
  color:var(--accent-blue);
}
.why-feat-title { font-size:0.78rem;font-weight:700;color:var(--text-primary);margin-bottom:4px; }
.why-feat-desc  { font-size:0.72rem;color:var(--text-muted);line-height:1.5; }

/* Stats row under why-features */
.stats-row { display:grid;grid-template-columns:repeat(4,1fr);gap:20px; }
.stats-item { text-align:center; }
.stats-num {
  font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;
  background:var(--gradient-primary);-webkit-background-clip:text;
  -webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:4px;
}
.stats-lbl { font-size:0.8rem;color:var(--text-muted);font-weight:500; }

/* ── TESTIMONIALS ───────────────────────────────────────────── */
.testi-wrap {
  position:relative;overflow:hidden;
}
.testi-track { display:flex;transition:transform 0.5s ease; }
.testi-slide {
  min-width:100%;
  display:flex;align-items:center;gap:48px;
  padding:0 60px;
}
.testi-quote-icon {
  font-family:'Syne',sans-serif;font-size:5rem;font-weight:800;
  color:var(--accent-blue);opacity:0.3;line-height:0.7;
  flex-shrink:0;align-self:flex-start;
}
.testi-left { flex-shrink:0; }
.testi-left-title { font-family:'Syne',sans-serif;font-size:1.8rem;font-weight:800;line-height:1.15;margin-bottom:0; }
.testi-content { flex:1; }
.testi-text { font-size:1rem;color:var(--text-secondary);line-height:1.8;margin-bottom:20px; }
.testi-author { display:flex;align-items:center;gap:12px; }
.testi-avatar {
  width:44px;height:44px;border-radius:50%;background:var(--gradient-primary);
  display:flex;align-items:center;justify-content:center;
  font-family:'Syne',sans-serif;font-weight:800;font-size:1rem;color:#fff;flex-shrink:0;
}
.testi-name { font-weight:700;font-size:0.9rem;color:var(--text-primary); }
.testi-role { font-size:0.78rem;color:var(--text-muted); }
.testi-stars { display:flex;gap:2px;margin-top:4px; }
.testi-star { font-size:0.9rem;color:var(--accent-orange); }
.testi-nav {
  position:absolute;top:50%;transform:translateY(-50%);
  width:36px;height:36px;border-radius:50%;
  background:var(--bg-elevated);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;color:var(--text-secondary);font-size:1rem;
  transition:background 0.2s,border-color 0.2s;z-index:10;
}
.testi-nav:hover { background:var(--accent-blue);border-color:var(--accent-blue);color:#fff; }
.testi-prev { left:8px; }
.testi-next { right:8px; }
.testi-outer {
  background:var(--bg-card);border:1px solid var(--border);
  border-radius:20px;padding:48px 0;position:relative;overflow:hidden;
}
.testi-dots { display:flex;justify-content:center;gap:8px;margin-top:24px; }
.testi-dot {
  width:8px;height:8px;border-radius:50%;
  background:var(--border);cursor:pointer;transition:background 0.2s;
}
.testi-dot.active { background:var(--accent-blue); }

/* ── CTA ────────────────────────────────────────────────────── */
.cta-section {
  padding:80px 0;
  background:linear-gradient(135deg,#1a3a6b 0%,#2563eb 40%,#7c3aed 100%);
  position:relative;overflow:hidden;
}
html.light .cta-section {
  background:linear-gradient(135deg,#1e40af 0%,#2563eb 45%,#7c3aed 100%);
}
.cta-glow {
  position:absolute;pointer-events:none;border-radius:50%;
  background:rgba(255,255,255,0.05);
}
.cta-glow-1 { width:400px;height:400px;top:-150px;left:-100px; }
.cta-glow-2 { width:300px;height:300px;bottom:-100px;right:-50px; }
.cta-inner {
  position:relative;z-index:1;
  display:flex;align-items:center;justify-content:space-between;
  gap:40px;flex-wrap:wrap;
}
.cta-left { flex:1;min-width:300px; }
.cta-title { font-family:'Syne',sans-serif;font-size:clamp(1.6rem,3vw,2.4rem);font-weight:800;color:#fff;margin-bottom:10px;letter-spacing:-0.02em; }
.cta-desc  { font-size:0.95rem;color:rgba(255,255,255,0.75);line-height:1.7; }
.cta-right { display:flex;flex-direction:column;align-items:flex-end;gap:12px;flex-shrink:0; }
.btn-cta-primary {
  display:inline-flex;align-items:center;gap:8px;
  padding:14px 28px;background:#fff;border-radius:var(--radius-sm);
  color:#1e40af;font-weight:700;font-size:0.95rem;text-decoration:none;
  transition:transform 0.15s,box-shadow 0.15s;white-space:nowrap;
}
.btn-cta-primary:hover { transform:translateY(-1px);box-shadow:0 8px 24px rgba(0,0,0,0.2);color:#1e40af; }
.btn-cta-secondary {
  display:inline-flex;align-items:center;gap:8px;
  padding:13px 28px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.3);
  border-radius:var(--radius-sm);color:#fff;font-weight:600;font-size:0.95rem;
  text-decoration:none;transition:background 0.15s;white-space:nowrap;
}
.btn-cta-secondary:hover { background:rgba(255,255,255,0.2);color:#fff; }
.cta-rocket { font-size:2.5rem;display:inline-block;animation:rocketFloat 2s ease-in-out infinite; }
@keyframes rocketFloat { 0%,100%{transform:translateY(0) rotate(0)} 50%{transform:translateY(-6px) rotate(5deg)} }

/* ── FOOTER ─────────────────────────────────────────────────── */
.lp-footer {
  background:#0d1117;
  border-top:1px solid rgba(255,255,255,0.06);
  padding:64px 0 32px;
}
html.light .lp-footer { background:#111827; }
.footer-grid { display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1fr;gap:40px;margin-bottom:48px; }
.footer-brand-name { font-family:'Syne',sans-serif;font-size:1.1rem;font-weight:800;color:#fff;margin-bottom:10px; }
.footer-brand-desc { font-size:0.83rem;color:#64748b;line-height:1.7;margin-bottom:20px;max-width:220px; }
.footer-socials { display:flex;gap:8px; }
.footer-social {
  width:32px;height:32px;border-radius:8px;background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;
  color:#64748b;text-decoration:none;transition:background 0.15s,color 0.15s,border-color 0.15s;
}
.footer-social:hover { background:rgba(99,179,237,0.15);border-color:rgba(99,179,237,0.3);color:#63b3ed; }
.footer-col-title { font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#94a3b8;margin-bottom:16px; }
.footer-link {
  display:block;font-size:0.85rem;color:#64748b;text-decoration:none;
  padding:4px 0;transition:color 0.15s;
}
.footer-link:hover { color:#e2e8f0; }
.footer-bottom {
  padding-top:24px;border-top:1px solid rgba(255,255,255,0.06);
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;
}
.footer-bottom p { font-size:0.8rem;color:#475569; }

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media(max-width:1024px){
  .hero-grid       { grid-template-columns:1fr;gap:48px; }
  .mockup-wrap     { max-width:540px;margin:0 auto;animation:none; }
  .svc-grid        { grid-template-columns:repeat(2,1fr); }
  .portfolio-grid  { grid-template-columns:repeat(2,1fr); }
  .why-layout      { grid-template-columns:1fr; }
  .why-features    { grid-template-columns:repeat(3,1fr); }
  .footer-grid     { grid-template-columns:repeat(2,1fr); }
  .cred-grid       { grid-template-columns:repeat(2,1fr); }
  .process-flow    { grid-template-columns:repeat(2,1fr);gap:24px; }
  .process-step::after { display:none; }
  .cta-inner       { flex-direction:column;text-align:center; }
  .cta-right       { align-items:center; }
}
@media(max-width:640px){
  .lp-section { padding:64px 0; }
  .svc-grid   { grid-template-columns:1fr; }
