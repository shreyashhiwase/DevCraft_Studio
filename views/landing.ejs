<!-- ═══════════════════════ PROCESS ════════════════════════════ -->
<section class="lp-section" id="process" style="background:var(--bg-secondary);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
  <div class="container">
    <div style="text-align:center;max-width:560px;margin:0 auto 56px;">
      <div class="lp-label">How It Works</div>
      <h2 style="margin-bottom:14px;">How We Turn Ideas Into Products</h2>
      <p style="color:var(--text-muted);font-size:1rem;line-height:1.7;">
        A clear, structured process so you always know what's happening and what comes next.
      </p>
    </div>
    <div class="process-grid">
      <div class="process-card">
        <div class="process-num">01</div>
        <div class="process-title">Discover</div>
        <div class="process-desc">Tell us about your idea, requirements, and business goals. We listen carefully before we write a single line of code.</div>
      </div>
      <div class="process-card">
        <div class="process-num">02</div>
        <div class="process-title">Plan</div>
        <div class="process-desc">We define scope, technology stack, timeline, and milestones. You get a clear picture of what we're building and when.</div>
      </div>
      <div class="process-card">
        <div class="process-num">03</div>
        <div class="process-title">Build</div>
        <div class="process-desc">Our team designs and develops your product with regular updates, real-time chat, and milestone tracking.</div>
      </div>
      <div class="process-card">
        <div class="process-num">04</div>
        <div class="process-title">Launch</div>
        <div class="process-desc">We deploy your product to production and provide ongoing support. We don't disappear after delivery.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════ WHY US ═════════════════════════════ -->
<section class="lp-section" id="why-us">
  <div class="container">
    <div style="text-align:center;max-width:560px;margin:0 auto 56px;">
      <div class="lp-label">Why StackifyX</div>
