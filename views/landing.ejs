<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/jpeg" href="/stackifyx-logo.jpg">
  <script>if(localStorage.getItem('devcraft-theme')==='light')document.documentElement.classList.add('light');</script>

  <!-- SEO -->
  <title>StackifyX — Digital Product & Software Development Company</title>
  <meta name="description" content="StackifyX builds fast, secure and scalable websites, web applications, mobile apps and custom software. Transparent development from start to finish.">
  <meta name="keywords" content="web development, mobile app development, custom software, digital product studio, Node.js, React, MongoDB, API development">
  <link rel="canonical" href="<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>">

  <!-- Open Graph -->
  <meta property="og:type"        content="website">
  <meta property="og:url"         content="<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>">
  <meta property="og:title"       content="StackifyX — Digital Product & Software Development Company">
  <meta property="og:description" content="We build fast, secure and scalable websites, web applications, mobile apps and custom software with a transparent development experience.">
  <meta property="og:image"       content="<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/stackifyx-logo.jpg">
  <meta name="twitter:card"       content="summary_large_image">
  <meta name="twitter:title"      content="StackifyX — Digital Product & Software Development">
  <meta name="twitter:description" content="We build fast, secure and scalable digital products.">

  <!-- Schema.org -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/#organization",
        "name": "StackifyX",
        "url": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>",
        "logo": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/stackifyx-logo.jpg",
        "description": "StackifyX builds websites, web applications, mobile apps and custom software for businesses.",
        "address": { "@type": "PostalAddress", "addressCountry": "IN" },
        "sameAs": ["<%= locals.linkedinURL || '' %>"]
      },
      {
        "@type": "WebSite",
        "@id": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/#website",
        "url": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>",
        "name": "StackifyX",
        "publisher": { "@id": "<%= process.env.APP_URL || 'https://stackifyx.onrender.com' %>/#organization" }
      }
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <%- include('partials/site-styles') %>
</head>

<body class="lp-wrap">
<%- include('partials/navbar') %>

<!-- ════════════════════════ HERO ════════════════════════════ -->
<section class="hero" aria-label="Hero">
  <div class="hero-glow hero-glow-a"></div>
  <div class="hero-glow hero-glow-b"></div>
  <div class="lp-c">
    <div class="hero-grid">

      <!-- Left -->
      <div>
        <div class="hero-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Digital Product Studio
        </div>
        <h1 class="hero-h1">
          Turn Your Ideas Into<br>
          <span class="grad">Digital Products.</span>
        </h1>
        <p class="hero-desc">
          We build fast, secure and scalable websites, web applications,
          mobile apps and custom software with a transparent development
          experience from start to finish.
        </p>
        <div class="hero-btns">
          <a href="/auth/register" class="btn btn-primary btn-lg" aria-label="Start your project">
            Start Your Project
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="#portfolio" class="btn btn-secondary btn-lg">View Our Work →</a>
        </div>
        <div class="hero-tags">
          <span class="hero-tag">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Web Development
          </span>
          <span class="hero-tag">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            Mobile Apps
          </span>
          <span class="hero-tag">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            Custom Software
          </span>
          <span class="hero-tag">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            AI & Automation
          </span>
        </div>
      </div>

      <!-- Right: Dashboard mockup -->
      <div>
        <div class="dash-mockup" role="img" aria-label="StackifyX project dashboard preview">
          <div class="dm-topbar">
            <div class="dm-dots">
              <div class="dm-dot" style="background:#ff5f57;"></div>
              <div class="dm-dot" style="background:#febc2e;"></div>
              <div class="dm-dot" style="background:#28c840;"></div>
            </div>
            <div class="dm-user">
              <div class="dm-av">S</div>
              StackifyX Dashboard
            </div>
            <span style="font-size:0.65rem;color:var(--accent-blue);font-weight:700;">LIVE</span>
          </div>
          <div class="dm-body">
            <div class="dm-greet">Welcome back,</div>
            <div class="dm-title">StackifyX Team ✦</div>
            <div class="dm-stats">
              <div class="dm-stat">
                <div class="dm-sval" style="color:var(--accent-blue);">12</div>
                <div class="dm-slbl">Projects</div>
                <div class="dm-strd" style="color:var(--accent-green);">Active</div>
              </div>
              <div class="dm-stat">
                <div class="dm-sval" style="color:var(--accent-orange);">5</div>
                <div class="dm-slbl">In Progress</div>
                <div class="dm-strd" style="color:var(--accent-orange);">Building</div>
              </div>
              <div class="dm-stat">
                <div class="dm-sval" style="color:var(--accent-green);">7</div>
                <div class="dm-slbl">Completed</div>
                <div class="dm-strd" style="color:var(--accent-green);">Delivered</div>
              </div>
              <div class="dm-stat">
                <div class="dm-sval" style="color:var(--accent-purple);">3</div>
                <div class="dm-slbl">Inquiries</div>
                <div class="dm-strd" style="color:var(--text-muted);">Pending</div>
              </div>
            </div>
            <div class="dm-cols">
              <div class="dm-panel">
                <div class="dm-ptitle">Project Progress</div>
                <div class="dm-proj">
                  <div class="dm-pname">StackifyX Platform</div>
                  <div class="dm-pbar"><div class="dm-pfill" style="width:80%;background:linear-gradient(90deg,#2563eb,#7c3aed);"></div></div>
                  <div class="dm-pmeta"><span>80% complete</span><span style="color:var(--accent-blue);">In Progress</span></div>
                </div>
                <div class="dm-proj">
                  <div class="dm-pname">Healthcare Platform</div>
                  <div class="dm-pbar"><div class="dm-pfill" style="width:60%;background:linear-gradient(90deg,#34d399,#059669);"></div></div>
                  <div class="dm-pmeta"><span>60% complete</span><span style="color:var(--accent-green);">On Track</span></div>
                </div>
                <div class="dm-proj">
                  <div class="dm-pname">TRUSTLEX.AJ</div>
                  <div class="dm-pbar"><div class="dm-pfill" style="width:40%;background:linear-gradient(90deg,#fbbf24,#f59e0b);"></div></div>
                  <div class="dm-pmeta"><span>40% complete</span><span style="color:var(--accent-orange);">Planning</span></div>
                </div>
              </div>
              <div class="dm-panel">
                <div class="dm-ptitle">Recent Activity</div>
                <div class="dm-act">
                  <div class="dm-adot" style="background:var(--accent-green);"></div>
                  <div><div class="dm-atxt">New project inquiry received</div><div class="dm-atime">2 min ago</div></div>
                </div>
                <div class="dm-act">
                  <div class="dm-adot" style="background:var(--accent-blue);"></div>
                  <div><div class="dm-atxt">Design milestone completed</div><div class="dm-atime">1 hr ago</div></div>
                </div>
                <div class="dm-act">
                  <div class="dm-adot" style="background:var(--accent-purple);"></div>
                  <div><div class="dm-atxt">Development update pushed</div><div class="dm-atime">3 hrs ago</div></div>
                </div>
                <div class="dm-act">
                  <div class="dm-adot" style="background:var(--accent-orange);"></div>
                  <div><div class="dm-atxt">Client message received</div><div class="dm-atime">5 hrs ago</div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ════════════════════════ CRED STRIP ══════════════════════ -->
<div class="cred-strip" aria-label="Key capabilities">
  <div class="lp-c">
    <div class="cred-grid">
      <div class="cred-item fade-up">
        <div class="cred-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div><div class="cred-title">Custom Solutions</div><div class="cred-desc">Built around your business, not generic templates.</div></div>
      </div>
      <div class="cred-item fade-up fade-up-delay-1">
        <div class="cred-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <div><div class="cred-title">Transparent Process</div><div class="cred-desc">Track your project throughout every stage of development.</div></div>
      </div>
      <div class="cred-item fade-up fade-up-delay-2">
        <div class="cred-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div><div class="cred-title">Modern Technology</div><div class="cred-desc">Scalable and future-ready architecture for long-term growth.</div></div>
      </div>
      <div class="cred-item fade-up fade-up-delay-3">
        <div class="cred-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div><div class="cred-title">Ongoing Support</div><div class="cred-desc">We stay involved and available well after launch.</div></div>
      </div>
    </div>
  </div>
</div>

<!-- ════════════════════════ SERVICES ════════════════════════ -->
<section class="lp-section" id="services" aria-labelledby="svc-heading">
  <div class="lp-c">
    <div class="lp-heading center" style="margin-bottom:56px;">
      <div class="lp-pill" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        What We Build
      </div>
      <h2 id="svc-heading">Powerful Solutions for Every Business</h2>
      <p>From idea to deployment, we provide everything you need to build and grow your digital product.</p>
    </div>
    <div class="svc-grid">
      <%
      const services = [
        { icon:'<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>', title:'Web Development', desc:'Responsive websites and powerful web applications built with modern, battle-tested technologies.' },
        { icon:'<rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>', title:'Mobile App Development', desc:'Cross-platform mobile applications for Android and iOS with native performance and modern UX.' },
        { icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>', title:'Custom Software', desc:'Tailored software solutions designed around your specific business workflows and requirements.' },
        { icon:'<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>', title:'E-Commerce Solutions', desc:'Online stores with payments, orders, inventory and customer management built to convert.' },
        { icon:'<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>', title:'AI & Automation', desc:'AI-powered tools and workflow automation to save time, cut costs and improve productivity.' },
        { icon:'<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>', title:'API & Integrations', desc:'Robust APIs and third-party integrations that connect your business systems seamlessly.' },
      ];
      %>
      <% services.forEach((s, i) => { %>
        <div class="svc-card fade-up fade-up-delay-<%= i % 3 %>">
          <div class="svc-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- s.icon %></svg>
          </div>
          <h3 class="svc-title"><%= s.title %></h3>
          <p class="svc-desc"><%= s.desc %></p>
          <a href="/auth/register" class="svc-link" aria-label="Learn more about <%= s.title %>">
            Learn more
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ════════════════════════ PORTFOLIO ═══════════════════════ -->
<section class="lp-section lp-section-alt" id="portfolio" aria-labelledby="port-heading">
  <div class="lp-c">
    <div class="port-header">
      <div>
        <div class="lp-pill" aria-hidden="true">Selected Work</div>
        <h2 id="port-heading" style="font-family:'Manrope',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;letter-spacing:-0.03em;color:var(--text-primary);margin:0;">Projects We're Proud Of</h2>
      </div>
      <a href="/auth/register" style="font-size:0.88rem;font-weight:700;color:var(--accent-blue);white-space:nowrap;display:flex;align-items:center;gap:5px;">
        View All
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
    <p class="port-sub">Real products. Real solutions. Built for real business needs.</p>
    <div class="port-grid">

      <!-- Project 1 -->
      <article class="port-card fade-up">
        <div class="port-img" style="background:linear-gradient(135deg,#0f172a,#1e3a5f);">
          <div style="width:100%;padding:20px 16px;">
            <div style="background:rgba(37,99,235,0.15);border:1px solid rgba(37,99,235,0.3);border-radius:8px;padding:12px;margin-bottom:8px;">
              <div style="font-size:0.6rem;font-weight:700;color:#93c5fd;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px;">Project Dashboard</div>
              <div style="height:4px;background:rgba(255,255,255,0.1);border-radius:2px;overflow:hidden;margin-bottom:5px;"><div style="width:80%;height:100%;background:linear-gradient(90deg,#2563eb,#7c3aed);border-radius:2px;"></div></div>
              <div style="height:4px;background:rgba(255,255,255,0.1);border-radius:2px;overflow:hidden;margin-bottom:5px;"><div style="width:55%;height:100%;background:linear-gradient(90deg,#34d399,#059669);border-radius:2px;"></div></div>
              <div style="height:4px;background:rgba(255,255,255,0.1);border-radius:2px;overflow:hidden;"><div style="width:35%;height:100%;background:linear-gradient(90deg,#fbbf24,#f59e0b);border-radius:2px;"></div></div>
            </div>
            <div style="display:flex;gap:6px;">
              <div style="flex:1;background:rgba(37,99,235,0.1);border-radius:6px;padding:8px;text-align:center;"><div style="font-size:0.9rem;font-weight:800;color:#93c5fd;">12</div><div style="font-size:0.56rem;color:#64748b;">Projects</div></div>
              <div style="flex:1;background:rgba(52,211,153,0.1);border-radius:6px;padding:8px;text-align:center;"><div style="font-size:0.9rem;font-weight:800;color:#6ee7b7;">7</div><div style="font-size:0.56rem;color:#64748b;">Done</div></div>
              <div style="flex:1;background:rgba(167,139,250,0.1);border-radius:6px;padding:8px;text-align:center;"><div style="font-size:0.9rem;font-weight:800;color:#c4b5fd;">5</div><div style="font-size:0.56rem;color:#64748b;">Active</div></div>
            </div>
          </div>
        </div>
        <div class="port-body">
          <h3 class="port-name">StackifyX Platform</h3>
          <p class="port-desc">Project service and management platform for clients and development teams.</p>
          <div class="port-tags">
            <span class="port-tag">Node.js</span>
            <span class="port-tag">MongoDB</span>
            <span class="port-tag">Express</span>
            <span class="port-tag">EJS</span>
          </div>
          <a href="/auth/register" class="port-link" aria-label="View case study for StackifyX Platform">
            View Case Study
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </article>

      <!-- Project 2 -->
      <article class="port-card fade-up fade-up-delay-1">
        <div class="port-img" style="background:linear-gradient(135deg,#0d2818,#1a4731);">
          <div style="width:100%;padding:20px 16px;">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
              <div style="font-size:0.68rem;font-weight:800;color:#6ee7b7;">Healthcare Platform</div>
              <div style="padding:2px 8px;background:rgba(52,211,153,0.2);border-radius:100px;font-size:0.55rem;color:#6ee7b7;font-weight:700;">Active</div>
            </div>
            <div style="display:flex;align-items:flex-end;gap:4px;height:50px;margin-bottom:10px;">
              <% [35,55,40,70,60,80,65].forEach(h => { %>
                <div style="flex:1;height:<%= h %>%;background:rgba(52,211,153,0.4);border-radius:2px 2px 0 0;"></div>
              <% }) %>
            </div>
            <div style="background:rgba(52,211,153,0.08);border:1px solid rgba(52,211,153,0.2);border-radius:7px;padding:8px;font-size:0.6rem;color:#6ee7b7;">
              Healthcare management and digital services — appointment scheduling, patient records, digital billing.
            </div>
          </div>
        </div>
        <div class="port-body">
          <h3 class="port-name">Healthcare Platform</h3>
          <p class="port-desc">Healthcare management and digital services platform for clinics and hospitals.</p>
          <div class="port-tags">
            <span class="port-tag">Web App</span>
            <span class="port-tag">Node.js</span>
            <span class="port-tag">MongoDB</span>
            <span class="port-tag">Chart.js</span>
          </div>
          <a href="/auth/register" class="port-link" aria-label="View case study for Healthcare Platform">
            View Case Study
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </article>

      <!-- Project 3 -->
      <article class="port-card fade-up fade-up-delay-2">
        <div class="port-img" style="background:linear-gradient(135deg,#1a0a2e,#2d1454);">
          <div style="width:100%;padding:20px 16px;">
            <div style="font-size:0.68rem;font-weight:800;color:#c4b5fd;margin-bottom:8px;">TRUSTLEX.AJ</div>
            <div style="background:rgba(124,58,237,0.12);border:1px solid rgba(124,58,237,0.25);border-radius:8px;padding:10px;margin-bottom:8px;">
              <div style="font-size:0.58rem;color:#a78bfa;margin-bottom:6px;font-weight:600;">Legal Consultation Portal</div>
              <div style="display:flex;gap:5px;margin-bottom:5px;">
                <div style="width:28px;height:28px;background:rgba(124,58,237,0.2);border-radius:6px;display:flex;align-items:center;justify-content:center;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <div style="flex:1;background:rgba(124,58,237,0.1);border-radius:4px;padding:4px 6px;"><div style="font-size:0.55rem;color:#c4b5fd;font-weight:600;">Connect with certified lawyers</div></div>
              </div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:4px;">
