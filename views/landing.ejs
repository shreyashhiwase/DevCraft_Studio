</div>

<!-- ═══════════════════════ STATS BAR ══════════════════════════ -->
<section class="lp-section-sm">
  <div class="container">
    <div class="stats-bar">
      <div class="stats-bar-item">
        <div class="stats-bar-num">10+</div>
        <div class="stats-bar-lbl">Projects Delivered</div>
      </div>
