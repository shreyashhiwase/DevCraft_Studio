<section class="lp-section lp-section-alt" id="faq" aria-labelledby="faq-heading">
  <div class="lp-c">
    <div class="lp-heading center" style="margin-bottom:48px;">
      <div class="lp-pill" aria-hidden="true">Got Questions?</div>
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      <p>Answers to the questions we hear most often from businesses exploring a project with us.</p>
    </div>
    <div class="faq-list">
      <%
      const faqs = [
        { q:'What services does StackifyX provide?', a:'We build websites, web applications, mobile apps, custom software, e-commerce platforms, and API integrations, along with AI-powered automation tools for businesses of all sizes.' },
        { q:'How does the development process work?', a:'We follow a clear process: Discover, Plan, Build and Launch. You get visibility into scope, timeline and progress at every stage, plus ongoing support after launch.' },
        { q:'Can StackifyX build custom software for my business?', a:'Yes. We design custom software around your specific workflows — from internal management tools to booking systems and industry-specific platforms.' },
        { q:'Can you build an e-commerce website?', a:'Yes. We build online stores with product management, shopping cart, checkout, payment integration and order management built in.' },
        { q:'Can you develop mobile applications?', a:'Yes. We build cross-platform and native mobile apps for Android and iOS, including authentication, push notifications and API integration.' },
        { q:'How much does a website or software project cost?', a:'Cost depends on scope, features and complexity. Share your requirements through our contact form and we will give you a clear estimate.' },
        { q:'How long does development take?', a:'Timelines vary by project size — a simple website may take a few weeks, while custom software or larger platforms take longer. We will share a realistic timeline after understanding your requirements.' },
        { q:'Can I track my project progress?', a:'Yes. Registered clients get a dashboard to track milestones, inquiries and project status throughout development.' },
        { q:'Do you provide post-launch support?', a:'Yes. We remain available after deployment for bug fixes, improvements and questions — we do not disappear after delivery.' },
        { q:'How can I start a project with StackifyX?', a:'Reach out through our contact page or create an account to submit a project inquiry. Our team will follow up to discuss the next steps.' },
      ];
      %>
      <% faqs.forEach((f, i) => { %>
        <div class="faq-item" id="faq-item-<%= i %>">
          <button class="faq-q" onclick="toggleFaq(<%= i %>)" aria-expanded="false" aria-controls="faq-a-<%= i %>">
            <span><%= f.q %></span>
            <span class="faq-q-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-a" id="faq-a-<%= i %>">
            <p><%= f.a %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<script>
function toggleFaq(i){
  var item=document.getElementById('faq-item-'+i);
  var wasOpen=item.classList.contains('open');
  document.querySelectorAll('.faq-item.open').forEach(function(el){
    el.classList.remove('open');
    el.querySelector('.faq-q').setAttribute('aria-expanded','false');
  });
  if(!wasOpen){
    item.classList.add('open');
    item.querySelector('.faq-q').setAttribute('aria-expanded','true');
  }
}
</script>

