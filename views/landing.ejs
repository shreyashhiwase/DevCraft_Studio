<!-- ════════════════════════ 5. INDUSTRIES WE SERVE ════════════════════════ -->
<section class="lp-section" id="industries" aria-labelledby="ind-heading">
  <div class="lp-c">
    <div class="lp-heading center" style="margin-bottom:52px;">
      <div class="lp-pill" aria-hidden="true">Target Verticals</div>
      <h2 id="ind-heading">Industries We Build For</h2>
      <p>Every industry has distinct workflows and commercial goals. Here is how we engineer solutions tailored to your sector.</p>
    </div>
    <div class="ind-grid">
      <%
      const targetIndustries = [
        { name:'Healthcare & Clinics', slug:'healthcare', desc:'Patient records, doctor appointment scheduling & digital billing.' },
        { name:'Coaching & Education', slug:'education', desc:'Course catalogs, student inquiry funnels & batch announcements.' },
        { name:'Retail & E-Commerce', slug:'ecommerce', desc:'Custom online stores, Razorpay payments & order management.' },
        { name:'Manufacturing & B2B', slug:'manufacturing', desc:'Product catalogs, technical data sheets & RFQ inquiry portals.' },
        { name:'Startups & Tech Ventures', slug:'startups', desc:'MVP scoping, rapid prototype builds & scalable SaaS backends.' },
        { name:'Real Estate & Property', slug:'real-estate', desc:'Project presentation portals, floor plans & brochure lead funnels.' },
        { name:'Legal Consultation', slug:'legal', desc:'Advocate profile matching, booking flows & confidential client intake.' },
        { name:'Small & Medium Businesses', slug:'small-business', desc:'Professional business websites & WhatsApp inquiry tools.' },
      ];
      %>
      <% targetIndustries.forEach(ind => { %>
        <a href="/industries/<%= ind.slug %>" class="svc-card" style="text-decoration:none;color:inherit;display:block;">
