            <div class="mockup-project">
              <div class="mockup-proj-top">
                <span class="mockup-proj-name">Hospital Management App</span>
                <span class="badge badge-in-progress" style="font-size:0.6rem;padding:2px 8px;">In Progress</span>
              </div>
              <div class="mockup-prog-bar"><div class="mockup-prog-fill" style="width:45%;"></div></div>
              <div class="mockup-prog-lbl"><span>45% complete</span><span>Due 15 Jul</span></div>
            </div>

            <div class="mockup-project">
              <div class="mockup-proj-top">
                <span class="mockup-proj-name">Restaurant Booking System</span>
                <span class="badge badge-completed" style="font-size:0.6rem;padding:2px 8px;">Completed</span>
              </div>
              <div class="mockup-prog-bar"><div class="mockup-prog-fill" style="width:100%;"></div></div>
              <div class="mockup-prog-lbl"><span>Delivered ✓</span><span>₹45,000</span></div>
            </div>

            <!-- Mini chart placeholder -->
            
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════ CREDIBILITY STRIP ══════════════════ -->
