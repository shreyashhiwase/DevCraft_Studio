      <%
      const steps = [
        { n:'01', title:'Discover', desc:'We understand your idea, requirements and business goals before writing a single line of code.', icon:'<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' },
        { n:'02', title:'Plan',     desc:'We define scope, technology stack, timeline and milestones. You get full visibility into what we\'re building.', icon:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>' },
        { n:'03', title:'Build',    desc:'Our team designs and develops your product with regular updates, real-time chat and milestone check-ins.', icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>' },
        { n:'04', title:'Launch',   desc:'We deploy your product to production and provide ongoing support. We don\'t disappear after delivery.', icon:'<path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/>' },
      ];
