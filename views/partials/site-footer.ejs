<footer class="lp-footer" aria-label="Site footer">
    <div class="lp-c">
      <div class="foot-grid">
  
        <!-- Brand col -->
        <div>
          <div class="foot-logo-row">
            <img src="/stackifyx-logo.jpg" alt="StackifyX" style="width:30px;height:30px;border-radius:7px;background:#fff;padding:2px;object-fit:contain;">
            <span class="foot-brand-name">Stackify<span class="foot-brand-accent">X</span></span>
          </div>
          <p class="foot-desc">We build digital products that help businesses grow — from idea to production.</p>
          <div class="foot-socials">
            <% if (locals.linkedinURL) { %>
              <a href="<%= locals.linkedinURL %>" target="_blank" rel="noopener noreferrer" class="foot-social" title="LinkedIn" aria-label="LinkedIn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452H17.21v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.987V9h3.112v1.561h.046c.434-.82 1.491-1.684 3.067-1.684 3.279 0 3.884 2.159 3.884 4.966v6.609zM5.337 7.433a1.8 1.8 0 110-3.6 1.8 1.8 0 010 3.6zm1.557 13.019H3.78V9h3.114v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
