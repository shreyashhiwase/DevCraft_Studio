          <span class="foot-link" style="cursor:default;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            India
          </span>
        </address>
  
      </div>
  
      <div class="foot-bottom">
        <p>© <%= new Date().getFullYear() %> StackifyX. All rights reserved.</p>
        <p>Made with ♥ by StackifyX</p>
      </div>
    </div>
  </footer>
  