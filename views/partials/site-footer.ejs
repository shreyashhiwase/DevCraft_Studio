            <% } %>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="foot-social" title="GitHub" aria-label="GitHub">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
          </div>
        </div>
  
        <!-- Services -->
        <nav aria-label="Services links">
          <div class="foot-col-title">Services</div>
          <a href="/services" class="foot-link">Web Development</a>
          <a href="/services" class="foot-link">Mobile Apps</a>
          <a href="/services" class="foot-link">Custom Software</a>
          <a href="/services" class="foot-link">AI & Automation</a>
          <a href="/services" class="foot-link">API Development</a>
        </nav>
  
        <!-- Company -->
        <nav aria-label="Company links">
          <div class="foot-col-title">Company</div>
          <a href="/about"     class="foot-link">About</a>
          <a href="/work"      class="foot-link">Our Work</a>
          <a href="/why-us"    class="foot-link">Why Choose Us</a>
          <a href="/contact"   class="foot-link">Contact</a>
        </nav>
  
        <!-- Resources -->
        <nav aria-label="Resource links">
          <div class="foot-col-title">Resources</div>
          <a href="/#faq" class="foot-link">FAQ</a>
          <a href="/auth/register" class="foot-link">Start a Project</a>
          <a href="/auth/login" class="foot-link">Client Login</a>
        </nav>
  
        <!-- Contact -->
        <address style="font-style:normal;">
          <div class="foot-col-title">Contact</div>
          <a href="mailto:hello@stackifyx.com" class="foot-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            hello@stackifyx.com
          </a>
          <a href="/auth/login" class="foot-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            Client Login
