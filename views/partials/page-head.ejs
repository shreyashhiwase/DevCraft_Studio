<%
  const _base = process.env.APP_URL || 'https://www.stackifyx.jo3.org';
  const _path = locals.canonicalPath || '';
  const _url  = _base + (_path.startsWith('/') ? _path : ('/' + _path));
  const _desc = locals.metaDescription || 'StackifyX builds high-performance websites, e-commerce stores, mobile applications and custom software for businesses across India.';
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/jpeg" href="/stackifyx-logo.jpg">
<script>if(localStorage.getItem('devcraft-theme')==='light')document.documentElement.classList.add('light');</script>

<!-- Primary SEO Meta Tags -->
<title><%= title %></title>
<meta name="description" content="<%= _desc %>">
<link rel="canonical" href="<%= _url %>">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

<!-- Open Graph / Facebook -->
<meta property="og:type"        content="website">
<meta property="og:url"         content="<%= _url %>">
<meta property="og:title"       content="<%= title %>">
<meta property="og:description" content="<%= _desc %>">
<meta property="og:image"       content="<%= _base %>/stackifyx-logo.jpg">
<meta property="og:site_name"   content="StackifyX">
<meta property="og:locale"      content="en_IN">

<!-- Twitter Cards -->
<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:url"         content="<%= _url %>">
<meta name="twitter:title"       content="<%= title %>">
<meta name="twitter:description" content="<%= _desc %>">
<meta name="twitter:image"       content="<%= _base %>/stackifyx-logo.jpg">

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": _base + "/#organization",
      "name": "StackifyX",
      "url": _base,
      "logo": {
        "@type": "ImageObject",
        "url": _base + "/stackifyx-logo.jpg"
      },
      "description": "StackifyX is a premier software development and digital solutions company providing website development, custom software, and digital engineering to clients across India.",
      "areaServed": {
        "@type": "Country",
        "name": "India"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-8600214628",
        "contactType": "sales",
        "areaServed": "IN",
        "availableLanguage": ["English", "Hindi", "Marathi"]
      },
      "sameAs": [
        locals.linkedinURL || "https://www.linkedin.com/company/stackifyx",
        "https://www.instagram.com/stackifyx"
      ]
    },
    {
      "@type": "WebSite",
      "@id": _base + "/#website",
      "url": _base,
      "name": "StackifyX",
      "publisher": { "@id": _base + "/#organization" }
    },
    {
      "@type": "WebPage",
      "@id": _url + "#webpage",
      "url": _url,
      "name": title,
      "description": _desc,
      "isPartOf": { "@id": _base + "/#website" }
    },
    ...(locals.breadcrumbs && locals.breadcrumbs.length ? [{
      "@type": "BreadcrumbList",
      "itemListElement": locals.breadcrumbs.map((b, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": b.name,
        "item": _base + (b.path.startsWith('/') ? b.path : '/' + b.path)
      }))
    }] : [])
  ]
}) %>
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<%- include('site-styles') %>
