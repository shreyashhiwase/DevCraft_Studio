<%# views/partials/navbar.ejs %>
<script>if(localStorage.getItem('devcraft-theme')==='light')document.documentElement.classList.add('light');</script>

<nav class="navbar">
  <div class="nav-container">

    <!-- Brand -->
    <a href="/" class="nav-brand">
      <img src="/stackifyx-logo.jpg" alt="StackifyX" class="brand-logo-img">
      <span class="brand-text">Stackify<span class="brand-accent">X</span></span>
    </a>

    <!-- Right group -->
    <div style="display:flex;align-items:center;gap:0;">

      <div class="nav-links" id="navLinks">

        <% if (currentUser) { %>
          <!-- ── Logged-in desktop links ── -->
          <div class="nav-desktop-links">
            <% if (currentUser.role === 'admin') { %>
              <a href="/admin/dashboard" class="nav-link">Dashboard</a>
              <a href="/admin/inquiries"  class="nav-link">Inquiries</a>
              <a href="/admin/projects"   class="nav-link">Projects</a>
              <a href="/admin/users"      class="nav-link">Users</a>
              <a href="/admin/payments"   class="nav-link">Payments</a>
            <% } else { %>
              <a href="/dashboard"  class="nav-link">Dashboard</a>
              <a href="/inquiries"  class="nav-link">My Inquiries</a>
              <a href="/payments"   class="nav-link">Payments</a>
            <% } %>
          </div>

          <!-- Avatar dropdown -->
          <div class="nav-user" id="navUser">
            <div class="user-avatar" id="userAvatarBtn">
              <%= currentUser.name.charAt(0).toUpperCase() %>
            </div>
            <div class="user-dropdown" id="userDropdown">
              <div class="user-dropdown-inner">
                <div class="dropdown-header">
                  <strong><%= currentUser.name %></strong>
                  <span class="user-role-badge <%= currentUser.role %>"><%= currentUser.role %></span>
                </div>
                <div class="dropdown-divider"></div>
                <a href="/auth/logout" class="dropdown-item logout">Sign Out →</a>
              </div>
            </div>
          </div>

          <!-- Mobile menu (logged-in) -->
          <div class="mobile-nav-menu">
            <% if (currentUser.role === 'admin') { %>
              <a href="/admin/dashboard" class="mobile-nav-link">📊 Dashboard</a>
              <a href="/admin/inquiries"  class="mobile-nav-link">📋 Inquiries</a>
              <a href="/admin/projects"   class="mobile-nav-link">🏗️ Projects</a>
              <a href="/admin/users"      class="mobile-nav-link">👥 Users</a>
              <a href="/admin/payments"   class="mobile-nav-link">💰 Payments</a>
              <a href="/admin/reviews"    class="mobile-nav-link">⭐ Reviews</a>
            <% } else { %>
              <a href="/dashboard"     class="mobile-nav-link">📊 Dashboard</a>
              <a href="/inquiries/new" class="mobile-nav-link">➕ New Request</a>
              <a href="/inquiries"     class="mobile-nav-link">📋 My Inquiries</a>
              <a href="/payments"      class="mobile-nav-link">💳 Payments</a>
            <% } %>
            <div class="mobile-user-section">
              <div class="mobile-user-info">
                <div class="mobile-user-avatar"><%= currentUser.name.charAt(0).toUpperCase() %></div>
                <div>
                  <div class="mobile-user-name"><%= currentUser.name %></div>
                  <div class="mobile-user-email"><%= currentUser.email %></div>
                </div>
              </div>
              <a href="/auth/logout" class="mobile-signout-btn">Sign Out →</a>
            </div>
          </div>

        <% } else if (locals.isLanding) { %>
          <!-- ── Landing page only: section anchor links ── -->
          <div class="nav-desktop-links">
            <a href="#services" class="nav-link nav-anchor">Services</a>
            <a href="#process"  class="nav-link nav-anchor">Process</a>
            <a href="#why-us"   class="nav-link nav-anchor">Why Us</a>
            <a href="#contact"  class="nav-link nav-anchor">Contact</a>
            <div style="width:1px;height:18px;background:var(--border);margin:0 6px;flex-shrink:0;"></div>
            <a href="/auth/login"    class="nav-link">Login</a>
            <a href="/auth/register" class="nav-btn">Start a Project →</a>
          </div>

          <!-- Mobile menu (landing guest) -->
          <div class="mobile-nav-menu">
            <a href="#services"      class="mobile-nav-link mobile-nav-anchor">🌐 Services</a>
            <a href="#process"       class="mobile-nav-link mobile-nav-anchor">⚡ Process</a>
            <a href="#why-us"        class="mobile-nav-link mobile-nav-anchor">💡 Why Us</a>
            <a href="#contact"       class="mobile-nav-link mobile-nav-anchor">📬 Contact</a>
            <div style="height:1px;background:var(--border);margin:6px 0;"></div>
            <a href="/auth/login"    class="mobile-nav-link">🔑 Login</a>
            <a href="/auth/register" class="mobile-nav-link mobile-nav-highlight">🚀 Start a Project</a>
          </div>

        <% } else { %>
          <!-- ── Other guest pages (login, register, forgot-password, etc.) ── -->
          <!-- Only Login + Get Started, no section anchors -->
          <div class="nav-desktop-links">
            <a href="/auth/login"    class="nav-link">Login</a>
            <a href="/auth/register" class="nav-btn">Get Started</a>
          </div>

          <div class="mobile-nav-menu">
            <a href="/auth/login"    class="mobile-nav-link">🔑 Login</a>
            <a href="/auth/register" class="mobile-nav-link mobile-nav-highlight">✨ Get Started Free</a>
          </div>

        <% } %>

      </div><!-- end nav-links -->

      <!-- LinkedIn -->
      <% if (locals.linkedinURL) { %>
        <a href="<%= locals.linkedinURL %>" target="_blank" rel="noopener noreferrer"
           class="nav-icon-btn linkedin-btn" title="Connect on LinkedIn" aria-label="LinkedIn"
           style="margin-left:12px; margin-right:8px;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452H17.21v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.987V9h3.112v1.561h.046c.434-.82 1.491-1.684 3.067-1.684 3.279 0 3.884 2.159 3.884 4.966v6.609zM5.337 7.433a1.801 1.801 0 110-3.602 1.8 1.8 0 010 3.602zm1.557 13.019H3.78V9h3.114v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      <% } %>

      <!-- Theme toggle -->
      <button class="theme-toggle" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">
        <span class="t-dark">🌙</span>
        <span class="t-light">☀️</span>
      </button>

      <!-- Hamburger -->
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>

    </div>
  </div>
</nav>

<script>
// Theme
(function(){
  const html=document.documentElement,btn=document.getElementById('themeToggle');
  if(localStorage.getItem('devcraft-theme')==='light')html.classList.add('light');
  btn?.addEventListener('click',()=>{
    const l=html.classList.toggle('light');
    localStorage.setItem('devcraft-theme',l?'light':'dark');
  });
})();

// Hamburger
const navToggle=document.getElementById('navToggle'),navLinks=document.getElementById('navLinks');
navToggle?.addEventListener('click',e=>{
  e.stopPropagation();
  navLinks?.classList.toggle('mobile-open');
  navToggle.classList.toggle('active');
});
document.addEventListener('click',e=>{
  if(!navLinks?.contains(e.target)&&!navToggle?.contains(e.target)){
    navLinks?.classList.remove('mobile-open');
    navToggle?.classList.remove('active');
  }
});

// Smooth scroll — only for anchor links on landing page
document.querySelectorAll('.nav-anchor, .mobile-nav-anchor').forEach(a=>{
  a.addEventListener('click',e=>{
    const href=a.getAttribute('href');
    if(href && href.startsWith('#')){
      const target=document.querySelector(href);
      if(target){
        e.preventDefault();
        target.scrollIntoView({behavior:'smooth',block:'start'});
        navLinks?.classList.remove('mobile-open');
        navToggle?.classList.remove('active');
      }
    }
  });
});

// Avatar dropdown
const avatarBtn=document.getElementById('userAvatarBtn'),dropdown=document.getElementById('userDropdown');
if(avatarBtn&&dropdown){
  avatarBtn.addEventListener('click',e=>{e.stopPropagation();dropdown.classList.toggle('open');});
  document.addEventListener('click',()=>dropdown.classList.remove('open'));
  document.addEventListener('keydown',e=>{if(e.key==='Escape')dropdown.classList.remove('open');});
}
</script>
