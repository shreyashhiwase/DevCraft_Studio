<!DOCTYPE html>
<html lang="en">
<head>
<% locals.canonicalPath = '/blog'; %>
<% locals.breadcrumbs = [{ name:'Home', path:'/' }, { name:'Blog', path:'/blog' }]; %>
<%- include('partials/page-head') %>
</head>
<body class="lp-wrap">
<%- include('partials/navbar') %>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section class="page-hero">
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="lp-c page-hero-inner">
    <%- include('partials/breadcrumb') %>
    <div class="lp-pill" aria-hidden="true">StackifyX Blog</div>
    <h1>Guides on Websites, Software & Growing Online</h1>
    <p class="lead">Practical, no-fluff articles on the questions businesses actually ask us before starting a project.</p>
  </div>
</section>

<!-- ═══════════════════ POSTS GRID ═══════════════════ -->
<section class="lp-section lp-section-alt">
  <div class="lp-c">
    <div class="blog-grid">
      <% posts.forEach(p => { %>
        <a href="/blog/<%= p.slug %>" class="blog-card">
          <div class="blog-cat"><%= p.category %></div>
          <h2><%= p.title %></h2>
          <p class="blog-excerpt"><%= p.excerpt %></p>
          <div class="blog-meta">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <%= new Date(p.publishDate).toLocaleDateString('en-IN', { year:'numeric', month:'long', day:'numeric' }) %>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════════ CTA ═══════════════════ -->
<section class="lp-section">
  <div class="lp-c" style="max-width:900px;">
    <div class="cta-box">
      <div class="cta-glow-1" aria-hidden="true"></div>
      <div class="cta-glow-2" aria-hidden="true"></div>
      <div class="lp-pill" style="background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.25);color:#fff;" aria-hidden="true">Have an Idea?</div>
      <h2 class="cta-title">Let's Build It Together</h2>
      <p class="cta-desc">Tell us what you're trying to build and we'll help you figure out the right approach.</p>
      <div class="cta-btns">
        <a href="/contact" class="cta-btn-p">Get a Free Consultation</a>
        <a href="/services" class="cta-btn-s">View Services</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/site-footer') %>
</body>
</html>
