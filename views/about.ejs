<!DOCTYPE html>
<html lang="en">
<head>
<% locals.canonicalPath = '/about'; %>
<% locals.breadcrumbs = [{ name:'Home', path:'/' }, { name:'About', path:'/about' }]; %>
<%- include('partials/page-head') %>
</head>
<body class="lp-wrap">
<%- include('partials/navbar') %>

<!-- ═══════════════════ HERO ═══════════════════ -->
<section class="page-hero">
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="lp-c page-hero-inner">
    <%- include('partials/breadcrumb') %>
    <div class="lp-pill" aria-hidden="true">About Us</div>
    <h1>Building Digital Products With Purpose</h1>
    <p class="lead">StackifyX is a digital product development company focused on helping businesses turn ideas into websites, applications and custom software.</p>
  </div>
</section>

<!-- ═══════════════════ WHO WE ARE / WHAT WE DO ═══════════════════ -->
<section class="lp-section lp-section-alt">
  <div class="lp-c">
    <div class="about-grid">
      <div>
        <div class="lp-pill" aria-hidden="true">Who We Are</div>
        <h2 style="font-family:'Manrope',sans-serif;font-size:clamp(1.5rem,2.6vw,2.1rem);font-weight:800;letter-spacing:-0.03em;color:var(--text-primary);margin-bottom:16px;">A Digital Product Development Company</h2>
        <p style="font-size:0.95rem;color:var(--text-muted);line-height:1.8;margin-bottom:18px;">
          StackifyX works directly with founders, product teams and business owners to
          turn ideas into real products — with a clear process, transparent
          communication and a focus on long-term quality over short-term shortcuts.
        </p>
        <p style="font-size:0.95rem;color:var(--text-muted);line-height:1.8;">
          Rather than positioning as a general-purpose agency, we build websites,
          applications and custom software for real business use cases — and stay
          involved after launch instead of disappearing once a project ships.
        </p>
        <div class="about-checklist">
          <% [
            'Custom development for your exact requirements',
            'Direct communication — no account managers',
            'Clean, documented, maintainable code',
            'From MVP to full-scale production product',
            'Post-launch support and iteration',
          ].forEach(item => { %>
            <div class="about-check">
              <div class="about-check-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <%= item %>
            </div>
          <% }) %>
        </div>
        <div style="margin-top:32px;">
          <a href="/auth/register" class="btn btn-primary">Start a Project →</a>
        </div>
      </div>
      <div class="about-visual">
        <div style="position:absolute;top:-40px;right:-40px;width:180px;height:180px;background:radial-gradient(circle,rgba(37,99,235,0.08),transparent);border-radius:50%;pointer-events:none;"></div>
        <div class="lp-pill" aria-hidden="true" style="margin-bottom:16px;">What We Do</div>
        <% [
          { icon:'<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>', title:'Websites & Web Apps', sub:'Business sites, portals, dashboards' },
          { icon:'<rect x="5" y="2" width="14" height="20" rx="2"/>',  title:'Mobile Applications', sub:'Android, iOS, cross-platform' },
          { icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',  title:'Custom Software',        sub:'Built around your workflows' },
          { icon:'<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>',title:'E-Commerce & Automation', sub:'Stores, APIs, AI tooling' },
        ].forEach(item => { %>
          <div class="about-vis-item">
            <div class="about-vis-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- item.icon %></svg>
            </div>
            <div>
              <div class="about-vis-title"><%= item.title %></div>
              <div class="about-vis-sub"><%= item.sub %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════ MISSION / VISION ═══════════════════ -->
<section class="lp-section" aria-labelledby="mv-heading">
  <div class="lp-c">
    <div class="lp-heading center" style="margin-bottom:44px;">
      <div class="lp-pill" aria-hidden="true">Mission &amp; Vision</div>
      <h2 id="mv-heading">Why We Do What We Do</h2>
    </div>
    <div class="why-grid" style="grid-template-columns:repeat(2,1fr);max-width:900px;margin:0 auto;">
      <div class="why-card">
        <div class="why-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </div>
        <h3 class="why-title">Our Mission</h3>
        <p class="why-desc">To help businesses turn ideas into reliable, scalable and useful digital products.</p>
      </div>
      <div class="why-card">
        <div class="why-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <h3 class="why-title">Our Vision</h3>
        <p class="why-desc">To make high-quality software development more transparent, accessible and business-focused.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════ HOW WE WORK / PHILOSOPHY ═══════════════════ -->
<section class="lp-section lp-section-alt" aria-labelledby="phil-heading">
  <div class="lp-c">
    <div class="lp-heading center" style="margin-bottom:44px;">
      <div class="lp-pill" aria-hidden="true">How We Work</div>
      <h2 id="phil-heading">Our Development Philosophy</h2>
      <p>A clear, structured process so you always know what's happening and what comes next.</p>
    </div>
    <div class="proc-grid" role="list">
      <%
      const steps = [
        { n:'01', title:'Discover', desc:'We understand your idea, requirements and business goals before writing a single line of code.', icon:'<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' },
        { n:'02', title:'Plan',     desc:'We define scope, technology stack, timeline and milestones. You get full visibility into what we\'re building.', icon:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>' },
        { n:'03', title:'Build',    desc:'Our team designs and develops your product with regular updates, real-time chat and milestone check-ins.', icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>' },
        { n:'04', title:'Launch',   desc:'We deploy your product to production and provide ongoing support. We don\'t disappear after delivery.', icon:'<path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/>' },
      ];
      %>
      <% steps.forEach((s, i) => { %>
        <div class="proc-step" role="listitem">
          <div class="proc-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- s.icon %></svg>
          </div>
          <div class="proc-num"><%= s.n %></div>
          <h3 class="proc-title"><%= s.title %></h3>
          <p class="proc-desc"><%= s.desc %></p>
          <% if (i < steps.length - 1) { %>
            <div class="proc-arr" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════════ TECHNOLOGIES ═══════════════════ -->
<section class="lp-section" aria-labelledby="tech-heading2">
  <div class="lp-c">
    <div class="lp-heading center">
      <div class="lp-pill" aria-hidden="true">Our Stack</div>
      <h2 id="tech-heading2">Technologies We Use</h2>
      <p>We work with proven, production-ready technologies — the same ones powering this platform.</p>
    </div>
    <div class="tech-strip" role="list">
      <%
      const techs = [
        { name:'JavaScript',  icon:'<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>' },
        { name:'Node.js',     icon:'<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>' },
        { name:'Express.js',  icon:'<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>' },
        { name:'MongoDB',     icon:'<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>' },
        { name:'EJS',         icon:'<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>' },
        { name:'REST APIs',   icon:'<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>' },
        { name:'Socket.IO',   icon:'<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>' },
        { name:'Git',         icon:'<circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/>' },
      ];
      %>
      <% techs.forEach(t => { %>
        <div class="tech-badge" role="listitem">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- t.icon %></svg>
          <%= t.name %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════════════════ CTA ═══════════════════ -->
<section class="lp-section lp-section-alt">
  <div class="lp-c" style="max-width:900px;">
    <div class="cta-box">
      <div class="cta-glow-1" aria-hidden="true"></div>
      <div class="cta-glow-2" aria-hidden="true"></div>
      <div class="lp-pill" style="background:rgba(255,255,255,0.12);border-color:rgba(255,255,255,0.25);color:#fff;" aria-hidden="true">Ready to Build?</div>
      <h2 class="cta-title">Have an Idea?<br>Let's Build It.</h2>
      <p class="cta-desc">Tell us what you're trying to build. We'll help you turn your idea into a reliable, scalable digital product.</p>
      <div class="cta-btns">
        <a href="/contact" class="cta-btn-p">Get in Touch</a>
        <a href="/work" class="cta-btn-s">See Our Work</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/site-footer') %>
</body>
</html>
